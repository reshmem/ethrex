--- /dev/null
+++ b/tests/rpc_tests/eth_commands/report.html
@@ -0,0 +1,188 @@
+
+<html>
+<head>
+  <style>
+    body {
+      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
+      background-color: #f9f9f9;
+      color: #333;
+      margin: 0;
+      padding: 0;
+    }
+    header {
+      position: sticky;
+      top: 0;
+      background: #fff;
+      z-index: 999;
+      padding: 10px 20px;
+      box-shadow: 0 2px 5px rgba(0,0,0,0.1);
+      display: flex;
+      justify-content: space-between;
+      align-items: center;
+    }
+    .filters button {
+      margin-left: 10px;
+      background-color: #007bff;
+      border: none;
+      color: white;
+      padding: 6px 12px;
+      border-radius: 5px;
+      cursor: pointer;
+    }
+    .filters button:hover {
+      background-color: #0056b3;
+    }
+    .method {
+      border-left: 6px solid;
+      padding: 10px 15px;
+      margin: 8px 0;
+      background-color: #fff;
+      border-radius: 6px;
+      transition: transform 0.2s ease;
+      max-width: calc(100% - 320px);
+    }
+    .method:hover {
+      transform: scale(1.01);
+      z-index: 1;
+    }
+    .method.pass {
+      border-color: #28a745;
+    }
+    .method.fail {
+      border-color: #dc3545;
+    }
+    .method strong {
+      font-size: 16px;
+    }
+    .section {
+      margin: 30px 20px;
+      padding-bottom: 20px;
+      border-bottom: 1px solid #ddd;
