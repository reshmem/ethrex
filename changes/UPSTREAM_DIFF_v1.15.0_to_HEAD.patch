diff --git a/tests/solidity/migrations/48_malicious_migration.js b/tests/solidity/migrations/48_malicious_migration.js
new file mode 100644
index 000000000..6221b4527
--- /dev/null
+++ b/tests/solidity/migrations/48_malicious_migration.js
@@ -0,0 +1,16 @@
+const Foo = artifacts.require("Foo");
+const Bar = artifacts.require("Bar");
+const Mal = artifacts.require("Mal");
+
+module.exports = async function (deployer, network, accounts) {
+  // Deploy Bar
+  await deployer.deploy(Bar);
+  const bar = await Bar.deployed();
+
+  // Deploy Mal
+  await deployer.deploy(Mal);
+  const mal = await Mal.deployed();
+
+  // Deploy Foo using Mal's address (this simulates Eve's trick)
+  await deployer.deploy(Foo, mal.address);
+};
