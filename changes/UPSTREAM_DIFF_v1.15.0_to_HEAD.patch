new file mode 100644
index 000000000..f357651d1
--- /dev/null
+++ b/tests/rpc_tests/eth_commands/beacon/beacon_get_blinded_block.js
@@ -0,0 +1,63 @@
+const assert = require('chai').assert;
+var config = require('../lib/config');
+const Helpers = require('../lib/helpers');
+const fs = require('fs');
+
+const methodPath = 'eth/v1/beacon/blinded_blocks/head';
+const host = config.hosts.beacon || 'http://localhost:3500'; // Default to localhost if not set
+const logFile = './beacon_test_results.log';
+
+// Helper to format timestamp
+function timestamp() {
+    return new Date().toISOString();
+}
+
+// Clear log file before test run
+before(function(done) {
+    fs.writeFile(logFile, '', (err) => {
+        if (err) {
+            console.error(`[${timestamp()}] Failed to initialize log file:`, err);
+            return done(err);
+        }
+        done();
+    });
+});
+
+// Test function
+const asyncTest = function(host, done) {
+    const endpoint = `${host}/${methodPath}`;
+    let testResult = 'FAIL';
+
+    Helpers.httpGet(endpoint, function(result, status) {
+        try {
+            if (status === 200 && result) {
+                testResult = 'PASS';
+            }
+            else if (status === 400) {
+                // Log the error message in case of internal server error
+                testResult = 'FAIL';
+                const errorMessage = result.message || 'Internal server error';
+                console.error(`[${timestamp()}] Error: ${errorMessage}`);
+                assert.fail(`Test failed with status 500: ${errorMessage}`);
+            }
+
+            const logLine = `[${timestamp()}] Host: ${host}\nMethod: ${methodPath}\nResponse: ${JSON.stringify(result, null, 2)}\nTest_Result: ${testResult}\n\n`;
+            fs.appendFile(logFile, logLine, (err) => {
+                if (err) {
+                    console.error(`[${timestamp()}] Error writing to log file:`, err);
+                }
+            });
+
+            done();
+        } catch (err) {
+            done(err);
+        }
+    });
+};
+
+// Mocha describe block
+describe(methodPath, function() {
+    it('should fetch blinded beacon block by block_id and log output with test result', function(done) {
+        asyncTest(host, done);
+    });
+});
