+
+const FunctionContract = artifacts.require("Function");
+const XYZ = artifacts.require("XYZ");
+const assert = require("assert");
+const { Web3 } = require("web3");
+const web3 = new Web3("http://localhost:8545");
+
+contract("Function Contract Testing", () => {
+  let functionInstance;
+  let xyzInstance;
+
+  before(async () => {
+    functionInstance = await FunctionContract.deployed();
+    xyzInstance = await XYZ.deployed();
+  });
+
+  it("Should return multiple values", async () => {
+    const result = await functionInstance.returnMany();
+    assert.strictEqual(result[0].toNumber(), 1, "First value should be 1");
+    assert.strictEqual(result[1], true, "Second value should be true");
+    assert.strictEqual(result[2].toNumber(), 2, "Third value should be 2");
+  });
+
+  it("Should return named values", async () => {
+    const result = await functionInstance.named();
+    assert.strictEqual(result.x.toNumber(), 1);
+    assert.strictEqual(result.b, true);
+    assert.strictEqual(result.y.toNumber(), 2);
+  });
+
+  it("Should return assigned values", async () => {
+    const result = await functionInstance.assigned();
+    assert.strictEqual(result.x.toNumber(), 1);
+    assert.strictEqual(result.b, true);
+    assert.strictEqual(result.y.toNumber(), 2);
+  });
+
+  it("Should return destructured assignment values", async () => {
+    const result = await functionInstance.destructuringAssignments();
+    assert.strictEqual(result[0].toNumber(), 1); // i
+    assert.strictEqual(result[1], true);         // b
+    assert.strictEqual(result[2].toNumber(), 2); // j
+    assert.strictEqual(result[3].toNumber(), 4); // x
+    assert.strictEqual(result[4].toNumber(), 6); // y
+  });
+
+  it("Should handle array input and output", async () => {
+    const tx = await functionInstance.arrayInput([10, 20, 30]);
+    // Not returning anything, just testing input
+
+    // Store values to contract state to test output
+    await functionInstance.arrayInput([1, 2, 3]);
+    const result = await functionInstance.arrayOutput();
+    assert(Array.isArray(result), "Should return an array");
+  });
+
+  it("Should call function with many inputs (positional)", async () => {
+    const result = await xyzInstance.callFunc();
+    assert.strictEqual(result.toNumber(), 0); 
+  });
+
+  it("Should call function with key-value inputs", async () => {
+    const result = await xyzInstance.callFuncWithKeyValue();
+    assert.strictEqual(result.toNumber(), 0);
+  });
+});
