@@ -0,0 +1,72 @@
+const assert = require('chai').assert;
+const Helpers = require('../lib/helpers');
+var config = require('../lib/config');
+const fs = require('fs');
+
+const methodPath = 'eth/v1/beacon/states/head/fork'; // Using "head" as state_id
+const url = config.hosts.beacon || 'http://localhost:3500'; // Default to localhost if not set
+const logFile = './beacon_test_results.log'; // Logging to the same file
+
+// Helper to format timestamp
+function timestamp() {
+    return new Date().toISOString();
+}
+
+// Clear log file before test run
+before(function(done) {
+    fs.writeFile(logFile, '', (err) => {
+        if (err) {
+            console.error(`[${timestamp()}] Failed to initialize beacon log file:`, err);
+            return done(err);
+        }
+        done();
+    });
+});
+
+const asyncTest = function(host, done) {
+    const endpoint = `${host}/${methodPath}`;
+
+    Helpers.httpGet(endpoint, function(result, status) {
+        let testResult = 'FAIL';
+
+        try {
+            assert.equal(status, 200, 'has status code 200');
+            assert.property(result, 'execution_optimistic');
+            assert.isBoolean(result.execution_optimistic, 'execution_optimistic is boolean');
+
+            assert.property(result, 'finalized');
+            assert.isBoolean(result.finalized, 'finalized is boolean');
+
+            assert.property(result, 'data', 'Expected data property');
+            assert.property(result.data, 'previous_version');
+            assert.match(result.data.previous_version, /^0x[a-fA-F0-9]{8}$/, 'previous_version is a valid version');
+
+            assert.property(result.data, 'current_version');
+            assert.match(result.data.current_version, /^0x[a-fA-F0-9]{8}$/, 'current_version is a valid version');
+
+            assert.property(result.data, 'epoch');
+            assert.match(result.data.epoch, /^[0-9]+$/, 'epoch is a numeric string');
+
+            testResult = 'PASS';
+        } catch (error) {
+            const errorLog = `[${timestamp()}] Host: ${host}\nMethod: ${methodPath}\nResponse: ${JSON.stringify(result)}\nTest_Result: ${testResult}\n\n`;
+            fs.appendFile(logFile, errorLog, (err) => {
+                if (err) console.error(`[${timestamp()}] Error writing to log file:`, err);
+            });
+            return done(error);
+        }
+
+        const logLine = `[${timestamp()}] Host: ${host}\nMethod: ${methodPath}\nResult: ${JSON.stringify(result)}\nTest_Result: ${testResult}\n\n`;
+        fs.appendFile(logFile, logLine, (err) => {
+            if (err) console.error(`[${timestamp()}] Error writing to log file:`, err);
+        });
+
+        done();
+    });
+};
+
+describe(methodPath, function() {
+    it('should return valid fork information', function(done) {
+        asyncTest(url, done);
+    });
+});
