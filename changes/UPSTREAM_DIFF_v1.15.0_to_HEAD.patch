@@ -0,0 +1,34 @@
+const Bank = artifacts.require("Bank");
+const HoneyPot = artifacts.require("HoneyPot");
+const Attack = artifacts.require("Attack");
+
+contract("Honeypot Trap Test", async (accounts) => {
+  const [alice] = accounts;
+
+  it("should trap attacker using HoneyPot", async () => {
+    const honeypot = await HoneyPot.deployed();
+    const bank = await Bank.deployed();
+
+    // Alice deposits 1 Ether
+    await bank.deposit({ from: alice, value: web3.utils.toWei("1", "ether") });
+
+    // Deploy Attack with bank address
+    const attack = await Attack.new(bank.address, { from: alice });
+
+    // Attacker tries to attack with 1 Ether
+    try {
+      await attack.attack({ from: alice, value: web3.utils.toWei("1", "ether") });
+      assert(false, "Attack should have failed due to Honeypot revert");
+    } catch (err) {
+      assert(err.message.includes("revert"), "Expected revert, got: " + err.message);
+    }
+
+    // Bank should still have 1 ether
+    const bankBalance = await web3.eth.getBalance(bank.address);
+    assert.equal(
+      bankBalance,
+      web3.utils.toWei("1", "ether"),
+      "Bank balance should remain intact after failed attack"
+    );
+  });
+});
diff --git a/tests/solidity/test/Hacks/malicious.js b/tests/solidity/test/Hacks/malicious.js
