+const CarFactory = artifacts.require("CarFactory");
+
+contract("CarFactory", (accounts) => {
+  const [deployer] = accounts;
+
+  it("should create a car using create()", async () => {
+    const factory = await CarFactory.deployed();
+    await factory.create(deployer, "Toyota", { from: deployer });
+
+    const carData = await factory.getCar(0);
+    assert.equal(carData.owner, deployer);
+    assert.equal(carData.model, "Toyota");
+    assert.equal(carData.balance.toString(), "0");
+  });
+
+  it("should create a car and send ether using createAndSendEther()", async () => {
+    const factory = await CarFactory.deployed();
+    await factory.createAndSendEther(deployer, "BMW", {
+      from: deployer,
+      value: web3.utils.toWei("1", "ether"),
+    });
+
+    const carData = await factory.getCar(1);
+    assert.equal(carData.model, "BMW");
+    assert.equal(carData.balance.toString(), web3.utils.toWei("1", "ether"));
+  });
+
+  it("should create a car using create2()", async () => {
+    const factory = await CarFactory.deployed();
+    const salt = web3.utils.soliditySha3("create2-salt-1");
+
+    await factory.create2(deployer, "Honda", salt, { from: deployer });
+
+    const carData = await factory.getCar(2);
+    assert.equal(carData.model, "Honda");
+    assert.equal(carData.balance.toString(), "0");
+  });
+
+  it("should create a car using create2AndSendEther()", async () => {
+    const factory = await CarFactory.deployed();
+    const salt = web3.utils.soliditySha3("create2-salt-2");
+
+    await factory.create2AndSendEther(deployer, "Tesla", salt, {
+      from: deployer,
+      value: web3.utils.toWei("0.5", "ether"),
+    });
+
+    const carData = await factory.getCar(3);
+    assert.equal(carData.model, "Tesla");
+    assert.equal(carData.balance.toString(), web3.utils.toWei("0.5", "ether"));
+  });
+});
