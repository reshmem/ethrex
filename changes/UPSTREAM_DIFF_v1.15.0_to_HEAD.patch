+const fs = require('fs');
+const Helpers = require('../lib/helpers');
+const assert = require('chai').assert;
+var config = require('../lib/config');
+
+const url = config.hosts.beacon || 'http://localhost:3500'; // Default to localhost if not set
+const logFile = './beacon_test_results.log';
+const stateValidatorsEndpoint = `${url}/eth/v1/beacon/states/head/validators`;
+
+// Timestamp helper
+function timestamp() {
+    return new Date().toISOString();
+}
+
+// Clear log file before test run
+before(function(done) {
+    fs.writeFile(logFile, '', (err) => {
+        if (err) return done(err);
+        done();
+    });
+});
+
+// Fetch validator IDs, then test validator_balances
+const asyncTest = function(host, done) {
+    Helpers.httpGet(stateValidatorsEndpoint, function(result, status) {
+        if (status !== 200 || !result.data || !Array.isArray(result.data)) {
+            const logLine = `[${timestamp()}] Host: ${host}\nMethod: eth/v1/beacon/states/head/validators\nResponse: ${JSON.stringify(result, null, 2)}\nTest_Result: FAIL\n\n`;
+            fs.appendFileSync(logFile, logLine);
+            return done(new Error('Failed to fetch validator list'));
+        }
+
+        // Pick first 2 validator IDs
+        const validatorIds = result.data.slice(0, 2).map(v => v.validator.pubkey);
+
+        const query = validatorIds.map(id => `id=${id}`).join('&');
+        const methodPath = `eth/v1/beacon/states/head/validator_balances?${query}`;
+        const endpoint = `${host}/${methodPath}`;
+        let testResult = 'FAIL';
+
+        Helpers.httpGet(endpoint, function(balanceResult, balanceStatus) {
+            try {
+                if (balanceStatus === 200) {
+                    testResult = 'PASS';
+                }
+                else if (balanceStatus === 400) {
+                    testResult = 'FAIL';
+                    const errorMessage = balanceResult.message || 'Internal server error';
+                    console.error(`[${timestamp()}] Error: ${errorMessage}`);
+                    assert.fail(`Test failed with status 400: ${errorMessage}`);
+                }
+
+                const logLine = `[${timestamp()}] Host: ${host}\nMethod: ${methodPath}\nResponse: ${JSON.stringify(balanceResult, null, 2)}\nTest_Result: ${testResult}\n\n`;
+                fs.appendFile(logFile, logLine, (err) => {
+                    if (err) console.error(`[${timestamp()}] Error writing to log file:`, err);
+                });
+
+                done();
+            } catch (error) {
+                done(error);
+            }
+        });
+    });
+};
+
+// Mocha test
+describe('eth/v1/beacon/states/head/validator_balances (dynamic pubkeys)', function() {
+    it('should fetch validator IDs and log their balances', function(done) {
+        asyncTest(url, done);
+    });
+});
