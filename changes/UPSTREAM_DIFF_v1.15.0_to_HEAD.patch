+contract("Caller and Callee Interaction", (accounts) => {
+  let callee, caller;
+  const user = accounts[0];
+
+  before(async () => {
+    callee = await Callee.deployed();
+    caller = await Caller.deployed();
+  });
+
+  it("should call setX from Caller using contract reference", async () => {
+    await caller.setX(callee.address, 42, { from: user });
+    const x = await callee.x();
+    assert.equal(x.toString(), "42", "Expected x to be 42");
+  });
