+import os
+import re
+import json
+from datetime import datetime
+from collections import defaultdict
+
+# Predefined test cases for eth and net
+ETH_TEST_CASES = ["eth_accounts", "eth_blobBaseFee", "eth_blockNumber", "eth_call", "eth_chainId", "eth_feeHistory", "eth_fillTransaction", "eth_gasPrice", "eth_getBalance", "eth_getBlockByNumber", "eth_getCode", "eth_getHeaderByHash", "eth_getHeaderByNumber", "eth_getLogs", "eth_getStorageAt", "eth_getTransactionByHash", "eth_getTransactionCount", "eth_getTransactionReceipt", "eth_getUncleByBlockHashAndIndex", "eth_getUncleByBlockNumberAndIndex", "eth_newFilter", "eth_pendingTransactions"]
+NET_TEST_CASES = ["net_version", "net_listening", "net_peerCount"]
+
+# Console log path and logs folder
+CONSOLE_LOG = "console_log.log"
+LOGS_FOLDER = "logs"
+
+# Helper to extract timestamp from file
+def get_timestamp(file_path):
+    ts = os.path.getmtime(file_path)
+    return datetime.fromtimestamp(ts).strftime('%Y-%m-%d %H:%M:%S')
+
+# Parse a single log file into structured data
+def parse_log_file(file_path):
+    with open(file_path, 'r') as f:
+        content = f.read()
+    entries = content.strip().split('\n\n')
+    results = {}
+    for entry in entries:
+        method_match = re.search(r"Method: (.+)", entry)
+        result_match = re.search(r"Result: (\{.*\})", entry, re.DOTALL)
+        test_result = re.search(r"Test_Result: (\w+)", entry)
+        if method_match:
+            method = method_match.group(1)
+            result = result_match.group(1).strip() if result_match else ""
+            status = test_result.group(1) if test_result else "MISSING"
+            results[method] = (result, status)
+    return results
+
+# Parse the console_log to find failure explanations
+def parse_console_log():
+    if not os.path.exists(CONSOLE_LOG):
+        return {}
+    with open(CONSOLE_LOG, 'r') as f:
+        content = f.read()
+    pattern = r"\n\s*\d+\) (.*?)\n([\s\S]+?)\n\s+at "
+    matches = re.findall(pattern, content)
+    failed_cases = {}
+    for method, message in matches:
+        method = method.strip()
+        failed_cases[method] = message.strip()
+    return failed_cases
+
+# Safely format result JSON and HTML block
+def format_method(method, result_json, status, explanation, idx):
+    cls = 'pass' if status == 'PASS' else 'fail'
+    color_label = status if status else "MISSING"
+    html = f'<div class="method {cls}"><strong>{method}</strong> - {color_label}'
+    try:
+        parsed_result = json.loads(result_json) if result_json else {}
+        formatted_result = json.dumps(parsed_result, indent=2)
+    except Exception:
+        formatted_result = result_json or "Invalid or missing result JSON"
+    full_msg = f"Result:\n{formatted_result}"
+    if explanation:
+        full_msg += f"\n\nExplanation:\n{explanation}"
+    if status != "PASS":
+        html += f'<br><button class="toggle-button" onclick="toggle(\'result{idx}\')">Show Details</button>'
+        html += f'<pre id="result{idx}" class="result-json">{full_msg.strip()}</pre>'
+    html += '</div>'
+    return html
+
+# Build final HTML
+HTML_TEMPLATE = """
+<html>
+<head>
+  <style>
+    body {{
+      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
+      background-color: #f9f9f9;
+      color: #333;
+      margin: 0;
+      padding: 0;
+    }}
+    header {{
+      position: sticky;
+      top: 0;
+      background: #fff;
+      z-index: 999;
+      padding: 10px 20px;
+      box-shadow: 0 2px 5px rgba(0,0,0,0.1);
+      display: flex;
+      justify-content: space-between;
+      align-items: center;
+    }}
+    .filters button {{
+      margin-left: 10px;
+      background-color: #007bff;
+      border: none;
+      color: white;
+      padding: 6px 12px;
+      border-radius: 5px;
+      cursor: pointer;
+    }}
+    .filters button:hover {{
+      background-color: #0056b3;
+    }}
+    .method {{
+      border-left: 6px solid;
+      padding: 10px 15px;
+      margin: 8px 0;
+      background-color: #fff;
+      border-radius: 6px;
+      transition: transform 0.2s ease;
+      max-width: calc(100% - 320px);
+    }}
+    .method:hover {{
+      transform: scale(1.01);
+      z-index: 1;
+    }}
+    .method.pass {{
+      border-color: #28a745;
+    }}
+    .method.fail {{
+      border-color: #dc3545;
+    }}
+    .method strong {{
+      font-size: 16px;
+    }}
+    .section {{
+      margin: 30px 20px;
+      padding-bottom: 20px;
+      border-bottom: 1px solid #ddd;
+    }}
+    h2 {{
+      font-size: 20px;
+      color: #222;
+    }}
+    .toggle-button {{
+      margin-top: 10px;
+      padding: 5px 10px;
+      border-radius: 4px;
+      background: #333;
+      color: white;
+      cursor: pointer;
+      border: none;
+      font-size: 12px;
+    }}
+    .toggle-button:hover {{
+      background: #000;
+    }}
+    .result-json {{
+      display: none;
+      background: #f1f1f1;
+      padding: 10px;
+      border-radius: 6px;
+      margin-top: 10px;
+      font-size: 13px;
+      white-space: pre-wrap;
+      transition: all 0.2s ease;
+    }}
+    .chart-container {{
+      position: fixed;
+      top: 10px;
+      right: 10px;
+      width: 280px;
+      height: 300px;
+      background: #fff;
+      border-radius: 10px;
+      box-shadow: 0 2px 8px rgba(0,0,0,0.2);
+      padding: 10px;
+      z-index: 100;
+      display: flex;
+      flex-direction: column;
+      align-items: center;
+      justify-content: center;
+    }}
+    .chart-label {{
+      margin-top: 10px;
+      font-size: 14px;
+      color: #444;
+    }}
+  </style>
+</head>
+<body>
+<header>
+  <div><strong>Test Results Summary</strong></div>
+  <div class="filters">
+    <button onclick="filterResults('all')">All</button>
+    <button onclick="filterResults('pass')">Pass</button>
+    <button onclick="filterResults('fail')">Fail</button>
+  </div>
+</header>
+<div class="chart-container">
+  <canvas id="resultChart"></canvas>
+  <div class="chart-label">Total: {total} | Pass: {pass_count} | Fail: {fail_count}</div>
+</div>
+<div style="margin-top: 100px;">
+{content}
+</div>
+<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
+<script>
+function toggle(id) {{
+  const el = document.getElementById(id);
+  el.style.display = el.style.display === 'none' ? 'block' : 'none';
+}}
+function filterResults(filter) {{
+  const all = document.querySelectorAll('.method');
+  all.forEach(el => {{
+    if (filter === 'all') el.style.display = 'block';
+    else if (!el.classList.contains(filter)) el.style.display = 'none';
+    else el.style.display = 'block';
+  }});
+}}
+const data = {{
+  labels: ['PASS', 'FAIL'],
+  datasets: [{{
+    label: 'Test Results',
+    data: [{pass_count}, {fail_count}],
+    backgroundColor: ['#28a745', '#dc3545']
+  }}]
+}};
+const chart = new Chart(document.getElementById('resultChart'), {{ type: 'doughnut', data }});
+document.getElementById('resultChart').onclick = function(evt) {{
+  const activePoints = chart.getElementsAtEventForMode(evt, 'nearest', {{ intersect: true }}, true);
+  if (activePoints.length > 0) {{
+    const idx = activePoints[0].index;
+    const label = chart.data.labels[idx].toLowerCase();
+    filterResults(label);
+  }}
+}};
+</script>
+</body>
+</html>
+"""
+
+def main():
+    failed_explanations = parse_console_log()
+    files = sorted(os.listdir(LOGS_FOLDER))
+    total_pass, total_fail = 0, 0
+    section_html = ""
+    idx = 0
+
+    for file_name in files:
+        if not file_name.endswith(".log"):
+            continue
+        full_path = os.path.join(LOGS_FOLDER, file_name)
+        results = parse_log_file(full_path)
+        group_name = file_name.replace(".log", "")
+        timestamp = get_timestamp(full_path)
+        expected_methods = ETH_TEST_CASES if group_name.startswith("eth") else NET_TEST_CASES
+        section = [f'<div class="section"><h2>{group_name} ({timestamp})</h2>']
+
+        for method in expected_methods:
+            if method in results:
+                result_json, status = results[method]
+            else:
+                result_json, status = "", "FAIL"
+            explanation = failed_explanations.get(method, "")
+            if status == "PASS": total_pass += 1
+            else: total_fail += 1
+            section.append(format_method(method, result_json, status, explanation, idx))
+            idx += 1
+        section.append("</div>")
+        section_html += "\n".join(section)
+
+    total = total_pass + total_fail
+    final_html = HTML_TEMPLATE.format(content=section_html, pass_count=total_pass, fail_count=total_fail, total=total)
+    with open("report.html", "w") as f:
+        f.write(final_html)
+    print("✅ Report generated: report.html")
+
+if __name__ == '__main__':
+    main()
