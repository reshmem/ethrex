+const TestTransientStorage = artifacts.require("TestTransientStorage");
+const assert = require("assert");
+
+contract("Storage Comparison Test", (accounts) => {
+  let callbackInstance;
+  let storageInstance;
+  let transientInstance;
+
+  before(async () => {
+    callbackInstance = await Callback.new();
+    storageInstance = await TestStorage.new();
+    transientInstance = await TestTransientStorage.new();
+  });
+
+  it("Should retrieve value 123 from TestStorage via callback", async () => {
+    await callbackInstance.test(storageInstance.address);
+    const val = await callbackInstance.val();
+    console.log("Value from TestStorage:", val.toString());
+    assert.strictEqual(val.toString(), "123", "Expected value 123 from persistent storage");
+  });
+  it("Should NOT retrieve value 321 from TestTransientStorage via callback", async () => {
+    await callbackInstance.test(transientInstance.address);
