@@ -0,0 +1,49 @@
+const Foo = artifacts.require("Foo");
+const Bar = artifacts.require("Bar");
+const Mal = artifacts.require("Mal");
+
+contract("Foo / Bar / Mal Delegation", (accounts) => {
+  const alice = accounts[0];
+  let bar, mal, foo;
+
+  beforeEach(async () => {
+    mal = await Mal.new({ from: alice });
+    foo = await Foo.new(mal.address, { from: alice });
+    bar = await Bar.new({ from: alice });
+  });
+
+  it("should call Mal.log() instead of Bar.log()", async () => {
+    const tx = await foo.callBar({ from: alice });
+    const receipt = tx.receipt;
+
+    const rawLog = receipt.rawLogs[0];
+    const eventSig = web3.utils.sha3("Log(string)");
+    assert.equal(rawLog.topics[0], eventSig, "Expected Log(string) event");
+
+    const decoded = web3.eth.abi.decodeLog(
+      [{ type: "string", name: "message" }],
+      rawLog.data,
+      rawLog.topics.slice(1)
+    );
+
+    assert.equal(decoded.message, "Mal was called", "Expected Mal's log to be called");
+  });
+
+  it("should call Bar.log() if Foo is initialized with Bar", async () => {
+    const fooWithBar = await Foo.new(bar.address, { from: alice });
+    const tx = await fooWithBar.callBar({ from: alice });
+    const receipt = tx.receipt;
+
+    const rawLog = receipt.rawLogs[0];
+    const eventSig = web3.utils.sha3("Log(string)");
+    assert.equal(rawLog.topics[0], eventSig, "Expected Log(string) event");
+
+    const decoded = web3.eth.abi.decodeLog(
+      [{ type: "string", name: "message" }],
+      rawLog.data,
+      rawLog.topics.slice(1)
+    );
+
+    assert.equal(decoded.message, "Bar was called", "Expected Bar's log to be called");
+  });
+});
diff --git a/tests/solidity/test/Hacks/re_entrancy.js b/tests/solidity/test/Hacks/re_entrancy.js
new file mode 100644
index 000000000..c2b6106f9
--- /dev/null
+++ b/tests/solidity/test/Hacks/re_entrancy.js
@@ -0,0 +1,30 @@
+const EtherStore = artifacts.require("EtherStore");
+const Attack = artifacts.require("Attack");
+
+contract("EtherStore Reentrancy", accounts => {
+  const [owner] = accounts;
+
+  it("should drain funds using reentrancy attack", async () => {
+    const etherStore = await EtherStore.deployed();
+    const attack = await Attack.deployed();
+
+    // Deposit 1 ETH twice from the same account (simulate two users)
+    await etherStore.deposit({ from: owner, value: web3.utils.toWei("1", "ether") });
+    await etherStore.deposit({ from: owner, value: web3.utils.toWei("1", "ether") });
+
+    const storeBalBefore = await web3.eth.getBalance(etherStore.address);
+    console.log("EtherStore balance before attack:", web3.utils.fromWei(storeBalBefore, "ether"), "ETH");
+
+    // Execute the attack
+    await attack.attack({ from: owner, value: web3.utils.toWei("1", "ether") });
+
+    const storeBalAfter = await web3.eth.getBalance(etherStore.address);
+    const attackerBal = await web3.eth.getBalance(attack.address);
+
+    console.log("EtherStore balance after attack:", web3.utils.fromWei(storeBalAfter, "ether"), "ETH");
+    console.log("Attacker contract balance:", web3.utils.fromWei(attackerBal, "ether"), "ETH");
+
+    assert.equal(storeBalAfter, "0", "EtherStore should be empty after attack");
+    assert(attackerBal > web3.utils.toWei("2", "ether"), "Attacker should have stolen at least 2 ETH");
+  });
+});
