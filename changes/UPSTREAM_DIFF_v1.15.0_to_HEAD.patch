@@ -0,0 +1,58 @@
+const AssemblyMath = artifacts.require("AssemblyMath");
+
+contract("AssemblyMath", () => {
+  let asm;
+
+  beforeEach(async () => {
+    asm = await AssemblyMath.new();
+  });
+
+  describe("yul_add()", () => {
+    it("should add two numbers correctly", async () => {
+      const result = await asm.yul_add(10, 20);
+      assert.equal(result.toString(), "30");
+    });
+
+    it("should revert on overflow", async () => {
+      try {
+        await asm.yul_add(web3.utils.toBN("0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff"), 1);
+        assert.fail("Expected revert due to overflow");
+      } catch (err) {
+        assert(err.message.includes("revert"), "Expected revert error");
+      }
+    });
+  });
+
+  describe("yul_mul()", () => {
+    it("should multiply two numbers correctly", async () => {
+      const result = await asm.yul_mul(5, 6);
+      assert.equal(result.toString(), "30");
+    });
+
+    it("should revert on multiplication overflow", async () => {
+      try {
+        await asm.yul_mul(web3.utils.toBN("0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff"), 2);
+        assert.fail("Expected revert due to overflow");
+      } catch (err) {
+        assert(err.message.includes("revert"), "Expected revert error");
+      }
+    });
+  });
+
+  describe("yul_fixed_point_round()", () => {
+    it("should round to nearest multiple of base", async () => {
+      const result = await asm.yul_fixed_point_round(90, 100);
+      assert.equal(result.toString(), "100");
+    });
+
+    it("should round down when below midpoint", async () => {
+      const result = await asm.yul_fixed_point_round(40, 100);
+      assert.equal(result.toString(), "0");
+    });
+
+    it("should return same value when exact multiple", async () => {
+      const result = await asm.yul_fixed_point_round(300, 100);
+      assert.equal(result.toString(), "300");
+    });
+  });
+});
