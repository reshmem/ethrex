+    assert.strictEqual(event.args.message, "invalid address");
+  });
+
+  it("Should emit LogBytes for assert failure with address(1)", async () => {
+    const tx = await barInstance.tryCatchNewContract("0x0000000000000000000000000000000000000001");
+    const event = tx.logs.find(log => log.event === "LogBytes");
+    assert(event, "Expected LogBytes event not emitted");
+  });
+
+  it("Should emit 'Foo created' with valid address(2)", async () => {
+    const tx = await barInstance.tryCatchNewContract("0x0000000000000000000000000000000000000002");
+    const event = tx.logs.find(log => log.event === "Log");
+    assert(event, "Expected Log event not emitted");
+    assert.strictEqual(event.args.message, "Foo created");
+  });
+});
