+const Attack = artifacts.require("Attack");
+
+module.exports = function(deployer) {
+  deployer.deploy(TimeLock)
+    .then(() => {
+      return TimeLock.deployed();
+    })
+    .then(timeLockInstance => {
+      return deployer.deploy(Attack, timeLockInstance.address);
+    });
+};
