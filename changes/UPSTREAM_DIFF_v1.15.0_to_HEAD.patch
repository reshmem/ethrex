+const Roulette = artifacts.require("Roulette");
+
+contract("Roulette", (accounts) => {
+  before(async () => {
+    await web3.eth.sendTransaction({
+      from: accounts[0],
+      to: accounts[1],
+      value: web3.utils.toWei("20", "ether")
+    });
+    await web3.eth.sendTransaction({
+      from: accounts[0],
+      to: accounts[2],
+      value: web3.utils.toWei("20", "ether")
+    });
+  });
+
+  it("should not allow spin unless sent exactly 10 ether", async () => {
+    const roulette = await Roulette.deployed();
+
+    try {
+      await roulette.spin({ from: accounts[1], value: web3.utils.toWei("1", "ether") });
+      assert.fail("Should have thrown due to insufficient ether");
+    } catch (err) {
+      assert.include(err.message, "revert");
+    }
+  });
+
+  it("should not allow multiple spins in the same block", async () => {
+    const roulette = await Roulette.deployed();
+
+    // First spin is valid
+    await roulette.spin({ from: accounts[0], value: web3.utils.toWei("10", "ether") });
+
+    try {
+      await roulette.spin({ from: accounts[0], value: web3.utils.toWei("10", "ether") });
+      assert.fail("Should have reverted due to same block timestamp");
+    } catch (err) {
+      assert.include(err.message, "revert");
+    }
+  });
+});
