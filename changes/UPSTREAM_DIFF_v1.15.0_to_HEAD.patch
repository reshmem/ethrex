@@ -0,0 +1,82 @@
+const assert = require('chai').assert;
+const Helpers = require('../lib/helpers');
+var config = require('../lib/config');
+const fs = require('fs');
+
+const getHeadPath = 'eth/v1/beacon/headers/head';
+const postPath = 'eth/v1/validator/sync_committee_subscriptions';
+const host = config.hosts.validator || 'http://localhost:3500'; // Default to localhost if not set
+const logFile = './validator_test_results.log';
+
+const SLOTS_PER_EPOCH = 32;
+
+function timestamp() {
+    return new Date().toISOString();
+}
+
+// Clear log file before test
+before(function(done) {
+    fs.writeFile(logFile, '', (err) => {
+        if (err) return done(err);
+        done();
+    });
+});
+
+// Build request body
+function buildSyncCommitteeBody(untilEpoch, validatorIndex = 1, indices = ["1", "1"]) {
+    const entry = {
+        validator_index: validatorIndex.toString(),
+        sync_committee_indices: indices,
+        until_epoch: untilEpoch.toString()
+    };
+    return [entry, entry]; // Duplicate entries for testing
+}
+
+// Main async test
+const asyncPostTest = function(host, done) {
+    const getEndpoint = `${host}/${getHeadPath}`;
+
+    Helpers.httpGet(getEndpoint, function(result, status) {
+        try {
+            if (status !== 200 || !result.data || !result.data.header || !result.data.header.message) {
+                assert.fail(`Failed to fetch head slot. HTTP ${status}`);
+            }
+
+            const slot = parseInt(result.data.header.message.slot);
+            const currentEpoch = Math.floor(slot / SLOTS_PER_EPOCH);
+            const untilEpoch = currentEpoch + 4;
+
+            const postEndpoint = `${host}/${postPath}`;
+            const postBody = buildSyncCommitteeBody(untilEpoch);
+
+            Helpers.httpPost(postEndpoint, postBody, function(resultPost, postStatus) {
+                let testResult = 'FAIL';
+
+                if (postStatus === 200 || postStatus === 202 || postStatus === 204) {
+                    testResult = 'PASS';
+                } else {
+                    const errMsg = resultPost.message || 'Unknown error';
+                    console.error(`[${timestamp()}] POST Error: ${errMsg}`);
+                    assert.fail(`HTTP ${postStatus}: ${errMsg}`);
+                }
+
+                const logLine = `[${timestamp()}] Host: ${host}\nMethod: ${postPath}\nUntil Epoch: ${untilEpoch}\nRequest Body: ${JSON.stringify(postBody, null, 2)}\nResponse: ${JSON.stringify(resultPost, null, 2)}\nTest_Result: ${testResult}\n\n`;
+                fs.appendFile(logFile, logLine, (err) => {
+                    if (err) console.error(`[${timestamp()}] Log write failed:`, err);
+                });
+
+                done();
+            });
+
+        } catch (err) {
+            done(err);
+        }
+    });
+};
+
+// Mocha wrapper
+describe('eth/v1/validator/sync_committee_subscriptions (dynamic epoch)', function() {
+    it('should fetch head slot, compute epoch, then POST subscription', function(done) {
+        asyncPostTest(host, done);
+    });
+});
