+
+const FunctionModifier = artifacts.require("FunctionModifier");
+
+contract("FunctionModifier", (accounts) => {
+  let instance;
+  const [owner, user1, zeroAddress] = [accounts[0], accounts[1], "0x0000000000000000000000000000000000000000"];
+
+  beforeEach(async () => {
+    instance = await FunctionModifier.new();
+  });
+
+  it("should set the deployer as the owner", async () => {
+    const contractOwner = await instance.owner();
+    assert.equal(contractOwner, owner);
+  });
+
+  it("should allow the owner to change ownership", async () => {
+    await instance.changeOwner(user1, { from: owner });
+    const newOwner = await instance.owner();
+    assert.equal(newOwner, user1);
+  });
+
+  it("should reject changeOwner if called by non-owner", async () => {
+    try {
+      await instance.changeOwner(user1, { from: user1 });
+      assert.fail("Expected revert not received");
+    } catch (error) {
+      assert(error.message.includes("Not owner"), "Expected 'Not owner' error");
+    }
+  });
+
+  it("should reject changeOwner with zero address", async () => {
+    try {
+      await instance.changeOwner(zeroAddress, { from: owner });
+      assert.fail("Expected revert not received");
+    } catch (error) {
+      assert(error.message.includes("Not valid address"), "Expected 'Not valid address' error");
+    }
+  });
+});
