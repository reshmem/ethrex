+const Vault = artifacts.require("Vault");
+const assert = require("assert");
+
+contract("Vault", (accounts) => {
+  let vaultInstance;
+  const owner = accounts[0];
+  
+  // Helper function to convert hex to readable string (for bytes32)
+  function hexToString(hex) {
+    return web3.utils.hexToUtf8(hex).replace(/\0/g, '');
+  }
+
+  before(async () => {
+    // Deploy a new Vault with a password
+    const passwordString = "SuperSecretPassword";
+    const password = web3.utils.padRight(web3.utils.asciiToHex(passwordString), 64);
+    vaultInstance = await Vault.new(password);
+    
+    // Add some users for testing
+    const user1Password = web3.utils.padRight(web3.utils.asciiToHex("user1pwd"), 64);
+    const user2Password = web3.utils.padRight(web3.utils.asciiToHex("user2pwd"), 64);
+    
+    await vaultInstance.addUser(user1Password);
+    await vaultInstance.addUser(user2Password);
+  });
+
+  describe("Storage Layout Tests", () => {
+    it("should correctly store and retrieve count in slot 0", async () => {
+      const countFromContract = await vaultInstance.count();
+      const storageAtSlot0 = await web3.eth.getStorageAt(vaultInstance.address, 0);
+      
+      assert.equal(
+        countFromContract.toString(), 
+        web3.utils.hexToNumberString(storageAtSlot0), 
+        "Count value in slot 0 doesn't match"
+      );
+      assert.equal(countFromContract.toString(), "123", "Count should be 123");
+    });
+
+    it("should correctly pack owner, isTrue and u16 in slot 1", async () => {
+      const ownerFromContract = await vaultInstance.owner();
+      const isTrueFromContract = await vaultInstance.isTrue();
+      const u16FromContract = await vaultInstance.u16();
+      
+      const storageAtSlot1 = await web3.eth.getStorageAt(vaultInstance.address, 1);
+      
+      // The last 20 bytes of slot1 should be the owner address
+      const ownerFromStorage = "0x" + storageAtSlot1.slice(26).toLowerCase();
+      assert.equal(
+        ownerFromContract.toLowerCase(), 
+        ownerFromStorage, 
+        "Owner address in slot 1 doesn't match"
+      );
+      
+      // Check isTrue (1 byte at position 0x0...01)
+      const isTrueFromStorage = parseInt(storageAtSlot1.slice(24, 26), 16) === 1;
+      assert.equal(isTrueFromContract, isTrueFromStorage, "isTrue value in slot 1 doesn't match");
+      
+      // Check u16 (2 bytes right before isTrue)
+      const u16FromStorage = parseInt(storageAtSlot1.slice(20, 24), 16);
+      assert.equal(u16FromContract.toString(), u16FromStorage.toString(), "u16 value in slot 1 doesn't match");
+    });
+
+    it("should store private password in slot 2", async () => {
+      // We can directly access the private variable through low-level storage access
+      const storageAtSlot2 = await web3.eth.getStorageAt(vaultInstance.address, 2);
+      
+      // Convert the hex to string to verify it's our password
+      const passwordStr = hexToString(storageAtSlot2);
+      assert.equal(passwordStr, "SuperSecretPassword", "Password in slot 2 doesn't match");
+    });
+
+    it("should correctly calculate and access array elements", async () => {
+      // Get the array length from slot 6
+      const arrayLengthSlot = await web3.eth.getStorageAt(vaultInstance.address, 6);
+      const arrayLength = parseInt(arrayLengthSlot, 16);
+      assert.equal(arrayLength, 2, "Array should have 2 elements");
+      
+      // Calculate the location of the first user
+      const firstUserIdLocation = await vaultInstance.getArrayLocation(6, 0, 2);
+      const firstUserPasswordLocation = web3.utils.toBN(firstUserIdLocation).add(web3.utils.toBN(1));
+      
+      // Get storage at calculated location
+      const firstUserId = await web3.eth.getStorageAt(vaultInstance.address, firstUserIdLocation);
+      const firstUserPassword = await web3.eth.getStorageAt(vaultInstance.address, firstUserPasswordLocation);
+      
+      assert.equal(parseInt(firstUserId, 16), 0, "First user ID should be 0");
+      assert.equal(hexToString(firstUserPassword), "user1pwd", "First user password doesn't match");
+      
+      // Calculate and check second user
+      const secondUserIdLocation = await vaultInstance.getArrayLocation(6, 1, 2);
+      const secondUserPasswordLocation = web3.utils.toBN(secondUserIdLocation).add(web3.utils.toBN(1));
+      
+      const secondUserId = await web3.eth.getStorageAt(vaultInstance.address, secondUserIdLocation);
+      const secondUserPassword = await web3.eth.getStorageAt(vaultInstance.address, secondUserPasswordLocation);
+      
+      assert.equal(parseInt(secondUserId, 16), 1, "Second user ID should be 1");
+      assert.equal(hexToString(secondUserPassword), "user2pwd", "Second user password doesn't match");
+    });
+
+    it("should correctly calculate and access mapping elements", async () => {
+      // Calculate the location of user with id 1 in the mapping
+      const userInMapLocation = await vaultInstance.getMapLocation(7, 1);
+      const userPasswordInMapLocation = web3.utils.toBN(userInMapLocation).add(web3.utils.toBN(1));
+      
+      // Get storage at calculated location
+      const userId = await web3.eth.getStorageAt(vaultInstance.address, userInMapLocation);
+      const userPassword = await web3.eth.getStorageAt(vaultInstance.address, userPasswordInMapLocation);
