+const Lib = artifacts.require("Lib");
+const HackMe = artifacts.require("HackMe");
+const Attack = artifacts.require("Attack");
+
+module.exports = async function (deployer, network, accounts) {
+  const [deployerAccount] = accounts;
+
+  await deployer.deploy(Lib, { from: deployerAccount });
+  const libInstance = await Lib.deployed();
+
+  await deployer.deploy(HackMe, libInstance.address, { from: deployerAccount });
+  const hackMeInstance = await HackMe.deployed();
+
+  await deployer.deploy(Attack, hackMeInstance.address, { from: deployerAccount });
+};
