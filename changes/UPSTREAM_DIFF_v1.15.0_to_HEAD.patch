+const Gas = artifacts.require("Gas");
+
+contract("Gas", () => {
+  let instance;
+
+  beforeEach(async () => {
+    instance = await Gas.new();
+  });
+
+  it("should fail due to running out of gas", async () => {
+    try {
+      await instance.forever({ gas: 100000 }); // force failure
+      assert.fail("Expected out-of-gas or execution failure.");
+    } catch (err) {
+      const message = err.message.toLowerCase();
+      assert(
+        message.includes("out of gas") ||
+        message.includes("execution reverted") ||
+        message.includes("invalid opcode") ||
+        message.includes("exceeds gas limit") ||
+        message.includes("vm exception"),
+        `Unexpected error: ${err.message}`
+      );
+    }
+  });
+});
