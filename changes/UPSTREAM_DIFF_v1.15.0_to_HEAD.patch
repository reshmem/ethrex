+const config = require('../lib/config');
+const IpcProvider = require('./ipcProvider.js');
+const net = require('net');
+const _ = require('underscore');
+const BigNumber = require('bignumber.js');
+const assert = require('chai').assert;
+
+const useIpc = process.argv[process.argv.length - 1] === '--ipc';
+let ipcProvider;
+if (useIpc) {
+    ipcProvider = new IpcProvider(config.hosts.ipc, net);
+}
+
+const Helpers = {
+    send: function(host, data = {}, callback) {
+        const http = require('http');
+
+        const options = {
+            hostname: host.replace('http://', '').split(':')[0],
+            port: host.split(':')[2] || 80,
+            path: '/',
+            method: 'POST',
+            headers: {
+                'Content-Type': 'application/json',
+            },
+        };
+
+        const req = http.request(options, (res) => {
+            let responseData = '';
+            res.setEncoding('utf8');
+            res.on('data', (chunk) => responseData += chunk);
+            res.on('end', () => {
+                try {
+                    const result = JSON.parse(responseData);
+                    if (typeof callback === 'function') {
+                        callback(result, res.statusCode);
+                    } else {
+                        //console.error('Callback is not a function');
+                    }
+                } catch (e) {
+                    if (typeof callback === 'function') {
+                        callback({ error: 'Invalid JSON' }, res.statusCode);
+                    } else {
+                        console.error('Callback is not a function');
+                    }
+                }
+            });
+        });
+
+        req.on('error', (e) => {
+            if (typeof callback === 'function') {
+                callback({ error: e.message }, 500);
+            } else {
+                console.error('Callback is not a function');
+            }
+        });
+
+        req.write(JSON.stringify(data));
+        req.end();
+    },
+
+    httpGet: function(url, callback) {
+        const http = require('http');
+        const https = require('https');
+        const lib = url.startsWith('https') ? https : http;
+
+        lib.get(url, (res) => {
+            let data = '';
+            res.on('data', (chunk) => data += chunk);
+            res.on('end', () => {
+                try {
+                    const json = JSON.parse(data);
+                    callback(json, res.statusCode);
+                } catch (e) {
+                    callback({ error: 'Invalid JSON' }, res.statusCode);
+                }
+            });
+        }).on('error', (err) => {
+            callback({ error: err.message }, 500);
+        });
+    },
+
+    httpPost: function(url, postData, callback) {
+        const parsedUrl = new URL(url);
+        const jsonString = JSON.stringify(postData);
+
+        const options = {
+            hostname: parsedUrl.hostname,
+            port: parsedUrl.port || 80,
+            path: parsedUrl.pathname + parsedUrl.search,
+            method: 'POST',
+            headers: {
+                'Content-Type': 'application/json',
+                'Content-Length': Buffer.byteLength(jsonString)
+            }
+        };
+
+        const req = require('http').request(options, (res) => {
+            let responseData = '';
+            res.on('data', chunk => responseData += chunk);
+            res.on('end', () => {
+                try {
+                    callback(JSON.parse(responseData), res.statusCode);
+                } catch (err) {
+                    callback({ error: 'Invalid JSON' }, res.statusCode);
+                }
+            });
+        });
+
+        req.on('error', (e) => {
+            callback({ error: e.message }, 500);
+        });
+
+        req.write(jsonString);
+        req.end();
+    },
+
+    httpPostValidatorDuty: function(host, epoch, data, callback) {
+        const endpoint = `${host}/eth/v1/validator/duties/attester/${epoch}`;
+        Helpers.httpPost(endpoint, data, callback);
+    },
+
+    eachHost: function(callback) {
+        for (const key in config.hosts) {
+            callback(key.toUpperCase(), config.hosts[key]);
+        }
+    },
+
+    getKeyByValue: function(object, value) {
+        for (const prop in object) {
+            if (object[prop] === value) {
+                return prop;
+            }
+        }
+    },
+
+    getBlockByNumber: function(number) {
+        return _.find(config.testBlocks.blocks, (bl) => +bl.blockHeader.number === +number);
+    },
+
+    fromDecimal: function(number) {
+        return '0x' + new BigNumber(number.toString(10), 10).toString(16);
+    },
+
+    fromAscii: function(str) {
+        return '0x' + Buffer.from(str, 'ascii').toString('hex');
+    },
+
+    toAscii: function(hex) {
+        return Buffer.from(hex.replace(/^0x/, ''), 'hex').toString('ascii').replace(/\0/g, '');
+    },
+
+    padLeft: function(string, chars) {
+        string = string.replace(/^0x/, '');
+        return '0x' + string.padStart(chars, '0');
+    },
+
+    isAddress: function(address) {
+        return typeof address === 'string' && /^0x[0-9a-fA-F]{40}$/.test(address);
+    },
+
+    blockTest: function(result, blockHeader) {
+        assert.strictEqual(+result.number, +blockHeader.number, 'block number');
+        assert.strictEqual(result.hash, '0x' + blockHeader.hash, 'block hash');
+        assert.strictEqual(result.parentHash, '0x' + blockHeader.parentHash, 'parent hash');
+        assert.strictEqual(result.nonce, '0x' + blockHeader.nonce, 'nonce');
+        assert.strictEqual(result.sha3Uncles, '0x' + blockHeader.uncleHash, 'uncle hash');
+        assert.strictEqual(result.logsBloom, '0x' + blockHeader.bloom, 'logs bloom');
+        assert.strictEqual(result.transactionsRoot, '0x' + blockHeader.transactionsTrie, 'tx root');
+        assert.strictEqual(result.stateRoot, '0x' + blockHeader.stateRoot, 'state root');
+        assert.strictEqual(result.miner, '0x' + blockHeader.coinbase, 'miner');
+        assert.strictEqual(+result.difficulty, +blockHeader.difficulty, 'difficulty');
+        assert.strictEqual(result.extraData, blockHeader.extraData, 'extra data');
+        assert.strictEqual(+result.gasLimit, +blockHeader.gasLimit, 'gas limit');
+        assert.strictEqual(+result.gasUsed, +blockHeader.gasUsed, 'gas used');
+        assert.strictEqual(+result.timestamp, +blockHeader.timestamp, 'timestamp');
+        assert.isNumber(+result.size, 'size');
+        assert.isNumber(+result.totalDifficulty, 'total difficulty');
+    }
+};
+
+module.exports = Helpers;
