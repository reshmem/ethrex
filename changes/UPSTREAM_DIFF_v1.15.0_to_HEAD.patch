+const assert = require('chai').assert;
+const Helpers = require('../lib/helpers');
+var config = require('../lib/config');
+const fs = require('fs');
+
+const committeeIndex = 1;
+const beaconHeadPath = 'eth/v1/beacon/headers/head';
+const validatorPath = 'eth/v1/validator/attestation_data';
+const host = config.hosts.validator || 'http://localhost:3500'; // Default to localhost if not set
+const logFile = './validator_test_results.log';
+
+// Helper to format timestamp
+function timestamp() {
+    return new Date().toISOString();
+}
+
+// Clear log file before test run
+before(function(done) {
+    fs.writeFile(logFile, '', (err) => {
+        if (err) return done(err);
+        done();
+    });
+});
+
+// Retry GET for robustness
+function retryHttpGet(url, retries, callback) {
+    Helpers.httpGet(url, (result, status) => {
+        if (status === 200 || retries === 0) {
+            callback(result, status);
+        } else {
+            console.warn(`[${timestamp()}] Retry: ${url}, Remaining Attempts: ${retries}`);
+            setTimeout(() => retryHttpGet(url, retries - 1, callback), 1000);
+        }
+    });
+}
+
+// Main test logic
+const asyncAttestationDataTest = function(host, done) {
+    const beaconEndpoint = `${host}/${beaconHeadPath}`;
+    let testResult = 'FAIL';
+
+    retryHttpGet(beaconEndpoint, 3, function(result, status) {
+        if (status !== 200 || !result?.data?.header?.message?.slot) {
+            const logLine = `[${timestamp()}] Host: ${host}\nMethod: ${beaconHeadPath}\nResponse: ${JSON.stringify(result, null, 2)}\nTest_Result: FAIL (beacon head fetch failed)\n\n`;
+            fs.appendFile(logFile, logLine, () => done(new Error('Failed to fetch beacon head')));
+            return;
+        }
+
+        const exactSlot = parseInt(result.data.header.message.slot, 10);
+        if (isNaN(exactSlot) || exactSlot <= 0) {
+            return done(new Error('Invalid slot value fetched from beacon node'));
+        }
+
+        const validatorEndpoint = `${host}/${validatorPath}?slot=${exactSlot}&committee_index=${committeeIndex}`;
+
+        Helpers.httpGet(validatorEndpoint, function(valResult, valStatus) {
+            try {
+                if (valStatus === 200 && valResult?.data) {
+                    testResult = 'PASS';
+                }
+
+                const logLine = `[${timestamp()}] Host: ${host}\nMethod: ${validatorPath}\nQuery Params: slot=${exactSlot}, committee_index=${committeeIndex}\nResponse: ${JSON.stringify(valResult, null, 2)}\nTest_Result: ${testResult}\n\n`;
+                fs.appendFile(logFile, logLine, (err) => {
+                    if (err) console.error(`[${timestamp()}] Log write failed:`, err);
+                });
+
+                done();
+            } catch (err) {
+                done(err);
+            }
+        });
+    });
+};
+
+// Mocha wrapper
+describe(validatorPath, function() {
+    it('should fetch attestation data using exact slot and log result', function(done) {
+        asyncAttestationDataTest(host, done);
+    });
+});
diff --git a/tests/rpc_tests/eth_commands/validator/validator_sync_committee_subscriptions.js b/tests/rpc_tests/eth_commands/validator/validator_sync_committee_subscriptions.js
