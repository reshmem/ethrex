+const Wallet = artifacts.require("Wallet");
+const Attack = artifacts.require("Attack");
+
+module.exports = async function (deployer, network, accounts) {
+  // Deploy Wallet with initial 10 ETH from accounts[0] (Alice)
+  await deployer.deploy(Wallet, { from: accounts[0], value: web3.utils.toWei("10", "ether") });
+
+  // Deploy Attack using Wallet's address
+  const walletInstance = await Wallet.deployed();
+  await deployer.deploy(Attack, walletInstance.address, { from: accounts[0] }); // Eve
+};
