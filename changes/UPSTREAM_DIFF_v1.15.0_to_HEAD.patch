+const Target = artifacts.require("Target");
+const FailedAttack = artifacts.require("FailedAttack");
+const Hack = artifacts.require("Hack");
+
+contract("Target Attack Test", (accounts) => {
+  let target;
+
+  beforeEach(async () => {
+    target = await Target.new();
+  });
+
+  it("should not allow contract call via FailedAttack", async () => {
+    const failed = await FailedAttack.new();
+    try {
+      await failed.pwn(target.address);
+      assert.fail("Expected revert not received");
+    } catch (error) {
+      assert(
+        error.message.includes("no contract allowed"),
+        "Expected 'no contract allowed' revert"
+      );
+    }
+
+    const pwned = await target.pwned();
+    assert.equal(pwned, false, "Target should not be pwned");
+  });
+
+  it("should allow bypass using Hack during contract construction", async () => {
+    // Deploy Hack during constructor time to bypass isContract check
+    const hack = await Hack.new(target.address);
+
+    const isC = await hack.isContract();
+
+    const wasPwned = await target.pwned();
+    assert.equal(wasPwned, true, "Target should be pwned by Hack");
+  });
+});
