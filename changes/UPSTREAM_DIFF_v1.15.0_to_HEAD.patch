+
+const HashFunction = artifacts.require("HashFunction");
+const GuessTheMagicWord = artifacts.require("GuessTheMagicWord");
+const assert = require("assert");
+
+contract("HashFunction and GuessTheMagicWord Tests", (accounts) => {
+  let hashInstance;
+  let guessInstance;
+
+  before(async () => {
+    hashInstance = await HashFunction.deployed();
+    guessInstance = await GuessTheMagicWord.deployed();
+  });
+
+  it("Should return correct hash from hash function", async () => {
+    const text = "hello";
+    const num = 42;
+    const addr = accounts[0];
+
+    const contractHash = await hashInstance.hash(text, num, addr);
+
+    const expectedHash = web3.utils.soliditySha3(
+      { type: "string", value: text },
+      { type: "uint256", value: num },
+      { type: "address", value: addr }
+    );
+
+    console.log("Contract Hash:", contractHash);
+    console.log("Expected Hash:", expectedHash);
+
+    assert.strictEqual(
+      contractHash.toLowerCase(),
+      expectedHash.toLowerCase(),
+      "Hashed values do not match"
+    );
+  });
+
+  it('Should return true for correct magic word "Solidity"', async () => {
+    const result = await guessInstance.guess("Solidity");
+    assert.strictEqual(result, true, "Should return true for correct magic word");
+  });
+
+  it('Should return false for incorrect magic word', async () => {
+    const result = await guessInstance.guess("IncorrectWord");
+    assert.strictEqual(result, false, "Should return false for incorrect magic word");
+  });
+});
