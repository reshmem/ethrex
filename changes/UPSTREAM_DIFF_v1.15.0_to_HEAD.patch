+
+	"github.com/ethereum/go-ethereum/crypto/slhdsa"
+	// Ensure this import path is correct for your project structure
+)
+
+func TestSlhDsa(t *testing.T) {
+	// Generate SLHDSA keys
+	privateKey, err := slhdsa.GenerateNewKey()
+	if err != nil {
+		t.Fatalf("Failed to generate SLHDSA keys: %v", err)
+	}
+
+	// Use the provided hash (convert from hex to byte slice)
+	hashHex := "ce0677bb30baa8cf067c88db9811f4333d131bf8bcf12fe7065d211dce971008"
+	hash, err := hex.DecodeString(hashHex)
+	if err != nil {
+		t.Fatalf("Failed to decode hash: %v", err)
+	}
+
+	// Sign the hash
+	signature, err := slhdsa.Sign(hash, privateKey.SK)
+	if err != nil {
+		t.Fatalf("Error signing hash: %v", err)
+	}
+
+	fmt.Printf("SLHDSA Signature: %x\n", signature)
+
+	// Get the public key
+	publicKey := privateKey.Public()
+
+	// Verify the signature
+	verified := slhdsa.VerifySignature(publicKey.PK, hash, signature)
+	if !verified {
+		t.Fatalf("Error in verifying signature: %v", err)
+	}
+
+	// Print results
+	fmt.Printf("SLHDSA Private Key: %x\n", privateKey.SK)
+	fmt.Printf("SLHDSA Public Key: %x\n", publicKey.PK)
+	fmt.Printf("SLHDSA Signature Length: %d\n", len(signature))
+	fmt.Printf("SLHDSA Signature Verified: %t\n", verified)
+
+	// Add test assertions
+	if !verified {
+		t.Errorf("Signature verification failed")
+	}
+}
