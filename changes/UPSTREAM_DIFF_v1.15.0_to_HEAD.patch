diff --git a/tests/solidity/migrations/59_source_of_randomness_migration.js b/tests/solidity/migrations/59_source_of_randomness_migration.js
new file mode 100644
index 000000000..4c47998a2
--- /dev/null
+++ b/tests/solidity/migrations/59_source_of_randomness_migration.js
@@ -0,0 +1,18 @@
+const GuessTheRandomNumber = artifacts.require("GuessTheRandomNumber");
+const Attack = artifacts.require("Attack");
+
+module.exports = async function (deployer, network, accounts) {
+  const [deployerAccount] = accounts; // Single account for deployment
+
+  // Deploy the GuessTheRandomNumber contract with 1 Ether
+  await deployer.deploy(GuessTheRandomNumber, { from: deployerAccount, value: web3.utils.toWei("1", "ether") });
+
+  const guessTheRandomNumber = await GuessTheRandomNumber.deployed();
+
+  // Deploy the Attack contract
+  await deployer.deploy(Attack, { from: deployerAccount });
+  const attack = await Attack.deployed();
+
+  // Now, let's call the attack from the Attack contract using the deployed GuessTheRandomNumber contract
+  await attack.attack(guessTheRandomNumber.address, { from: deployerAccount });
+};
