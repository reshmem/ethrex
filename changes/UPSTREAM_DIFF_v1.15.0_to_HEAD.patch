+    #define SLH_K 17
+    #define SLH_M 39
+#elif defined(SLH_DSA_SHAKE_192f)
+    #define SLH_N 24
+    #define SLH_H 66
+    #define SLH_D 22
+    #define SLH_H_ 3
+    #define SLH_A 8
+    #define SLH_K 33
+    #define SLH_M 42
+#elif defined(SLH_DSA_SHAKE_256s)
+    #define SLH_N 32
+    #define SLH_H 64
+    #define SLH_D 8
+    #define SLH_H_ 8
+    #define SLH_A 14
+    #define SLH_K 22
+    #define SLH_M 47
+#elif defined(SLH_DSA_SHAKE_256f)
+    #define SLH_N 32
+    #define SLH_H 68
+    #define SLH_D 17
+    #define SLH_H_ 4
+    #define SLH_A 9
+    #define SLH_K 35
+    #define SLH_M 49
+#else
+    #define SLH_N 32
+    #define SLH_H 68
+    #define SLH_D 17
+    #define SLH_H_ 4
+    #define SLH_A 9
+    #define SLH_K 35
+    #define SLH_M 49
+    #warning "No SLH-DSA version defined. Defaulting to SLH_DSA_SHAKE_256f."
+#endif
+
+#if defined(SLH_DSA_SHAKE_256f)
+    #pragma message("SLH_DSA_SHAKE_256f is defined")
+#elif defined(SLH_DSA_SHAKE_256s)
+    #pragma message("SLH_DSA_SHAKE_256s is defined")
+#elif defined(SLH_DSA_SHAKE_192f)
+    #pragma message("SLH_DSA_SHAKE_192f is defined")
+#elif defined(SLH_DSA_SHAKE_192s)
+    #pragma message("SLH_DSA_SHAKE_192s is defined")
+#elif defined(SLH_DSA_SHAKE_128f)
+    #pragma message("SLH_DSA_SHAKE_128f is defined")
+#elif defined(SLH_DSA_SHAKE_128s)
+    #pragma message("SLH_DSA_SHAKE_128s is defined")
+#else
+    #pragma message("No SLH_DSA_SHAKE_* version is defined")
+#endif
+
+// Derived macros
+#define SLH_PK_BYTES (2 * SLH_N)
+#define SLH_SK_BYTES (4 * SLH_N)
+#define SLH_LEN2 3 // len2 = 3
+#define SLH_LEN1 (2 * SLH_N) // len1 = 2 * SLH_N
+#define SLH_LEN (SLH_LEN1 + SLH_LEN2) // len = len1 + len2
+#define SLH_BYTES (SLH_N + (SLH_K * (1 + SLH_A) * SLH_N) + ((SLH_H + SLH_D * SLH_LEN) * SLH_N))
+#define CRYPTO_SEEDBYTES (3 * SLH_N)
