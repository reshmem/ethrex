+        done();
+    });
+});
+
+const getParentRoot = (callback) => {
+    const endpoint = `${host}/eth/v1/beacon/headers/head`;
+    Helpers.httpGet(endpoint, function(result, status) {
+        if (status === 200 && result.data && result.data.header && result.data.header.message && result.data.header.message.parent_root) {
+            const parentRoot = result.data.header.message.parent_root;
+            callback(null, parentRoot);
+        } else {
+            callback(new Error('Failed to extract parent_root'));
+        }
+    });
+};
+
+const asyncTest = function(host, parentRoot, done) {
+    const method = `eth/v1/beacon/headers?slot=1&parent_root=${parentRoot}`;
+    const endpoint = `${host}/${method}`;
+    let testResult = 'FAIL';
+
+    Helpers.httpGet(endpoint, function(result, status) {
+        try {
+            if (status === 200) {
+                testResult = 'PASS';
+            }
+            else if (status === 400) {
+                // Log the error message in case of internal server error
+                testResult = 'FAIL';
+                const errorMessage = result.message || 'Internal server error';
+                console.error(`[${timestamp()}] Error: ${errorMessage}`);
+                assert.fail(`Test failed with status 500: ${errorMessage}`);
+            }
+
+            const logLine = `[${timestamp()}] Host: ${host}\nMethod: ${method}\nResponse: ${JSON.stringify(result, null, 2)}\nTest_Result: ${testResult}\n\n`;
+            fs.appendFile(logFile, logLine, (err) => {
+                if (err) {
+                    console.error(`[${timestamp()}] Error writing to log file:`, err);
+                }
+            });
+
+            done();
+        } catch (err) {
+            done(err);
+        }
+    });
+};
+
+describe('eth/v1/beacon/headers?slot=1&parent_root=', function() {
+    it('should fetch parent_root then query headers with it and log the result', function(done) {
+        getParentRoot((err, parentRoot) => {
+            if (err) return done(err);
+            asyncTest(host, parentRoot, done);
+        });
+    });
+});
