+const GuessTheRandomNumber = artifacts.require("GuessTheRandomNumber");
+const Attack = artifacts.require("Attack");
+
+contract("GuessTheRandomNumber", (accounts) => {
+  let guessGame, attackContract;
+
+  it("should deploy both contracts and win 1 ether using a single account", async () => {
+    const attacker = accounts[0];
+
+    // Deploy GuessTheRandomNumber with 1 Ether
+    guessGame = await GuessTheRandomNumber.new({ from: attacker, value: web3.utils.toWei("1", "ether") });
+
+    // Deploy Attack
+    attackContract = await Attack.new({ from: attacker });
+
+    const initialGameBalance = await web3.eth.getBalance(guessGame.address);
+    const initialAttackBalance = await web3.eth.getBalance(attackContract.address);
+
+    console.log("Initial Guess contract balance:", web3.utils.fromWei(initialGameBalance), "ETH");
+    console.log("Initial Attack contract balance:", web3.utils.fromWei(initialAttackBalance), "ETH");
+
+    // Attack from the same account
+    const tx = await attackContract.attack(guessGame.address, { from: attacker });
+
+    const finalGameBalance = await web3.eth.getBalance(guessGame.address);
+    const finalAttackBalance = await web3.eth.getBalance(attackContract.address);
+
+    console.log("Final Guess contract balance:", web3.utils.fromWei(finalGameBalance), "ETH");
+    console.log("Final Attack contract balance:", web3.utils.fromWei(finalAttackBalance), "ETH");
+
+    assert.equal(finalGameBalance, "0", "Game contract should be drained");
+    assert.equal(finalAttackBalance, web3.utils.toWei("1", "ether"), "Attack contract should hold 1 Ether");
+  });
+});
