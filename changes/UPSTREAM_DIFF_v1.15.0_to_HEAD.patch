@@ -0,0 +1,14 @@
+const Vault = artifacts.require("Vault");
+
+module.exports = async function(deployer) {
+  // Convert string to bytes32 for the password
+  const passwordString = "SuperSecretPassword";
+  // Pad the string with zeros to fit bytes32
+  const password = web3.utils.padRight(web3.utils.asciiToHex(passwordString), 64);
+  
+  // Deploy Vault with the password
+  await deployer.deploy(Vault, password);
+  
+  // Log the deployed contract address
+  const vault = await Vault.deployed();
+};
