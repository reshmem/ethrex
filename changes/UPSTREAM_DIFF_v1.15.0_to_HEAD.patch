diff --git a/crypto/slhdsa/libslhdsa/configure.ac b/crypto/slhdsa/libslhdsa/configure.ac
new file mode 100644
index 000000000..37304fb98
--- /dev/null
+++ b/crypto/slhdsa/libslhdsa/configure.ac
@@ -0,0 +1,106 @@
+AC_PREREQ([2.60])
+
+# Package version (semantic)
+define(_PKG_VERSION_MAJOR, 1)
+define(_PKG_VERSION_MINOR, 0)
+define(_PKG_VERSION_PATCH, 0)
+define(_PKG_VERSION_IS_RELEASE, false)
+
+# Library version (libtool ABI)
+define(_LIB_VERSION_CURRENT, 1)
+define(_LIB_VERSION_REVISION, 0)
+define(_LIB_VERSION_AGE, 0)
+
+AC_CONFIG_AUX_DIR([build-aux])
+AC_CONFIG_MACRO_DIR([build-aux/m4])
+
+AC_INIT([libslhdsa],
+    m4_join([.], _PKG_VERSION_MAJOR, _PKG_VERSION_MINOR, _PKG_VERSION_PATCH)m4_if(_PKG_VERSION_IS_RELEASE, [true], [], [-dev]),
+    [https://github.com/Quranium/Quranium_Core/issues],
+    [libslhdsa],
+    [https://github.com/Quranium/Quranium_Core])
+
+# Parameter configuration
+AC_ARG_VAR([PARAMS], [Specify the parameters to use (default: SLH_DSA_SHAKE_256f)])
+AS_IF([test -z "$PARAMS"], [PARAMS=SLH_DSA_SHAKE_256f])
+AC_SUBST([PARAMS])
+
+# Initialize tools and libraries
+AM_INIT_AUTOMAKE([foreign subdir-objects])
+AC_PROG_CXX
+AC_PROG_CC
+AM_PROG_AS
+LT_INIT([win32-dll])
+
+# Platform-specific checks
+build_windows=no
+case $host_os in
+  *darwin*)
+    if test x$cross_compiling != xyes; then
+      AC_CHECK_PROG([BREW], brew, brew)
+      if test x$BREW = xbrew; then
+        if $BREW list --versions valgrind >/dev/null; then
+          valgrind_prefix=$($BREW --prefix valgrind 2>/dev/null)
+          VALGRIND_CPPFLAGS="-I$valgrind_prefix/include"
+        fi
+      else
+        AC_CHECK_PROG([PORT], port, port)
+        if test x$PORT = xport; then
+          CPPFLAGS="$CPPFLAGS -isystem /opt/local/include"
+          LDFLAGS="$LDFLAGS -L/opt/local/lib"
+        fi
+      fi
+    fi
+    ;;
+  cygwin*|mingw*)
+    build_windows=yes
+    ;;
+esac
+
+# SIMD optimization flags
+AC_CANONICAL_HOST
+AC_CHECK_HEADERS([cpuid.h])
+AC_PATH_PROG([GREP], [grep])
+
+AC_MSG_CHECKING([for AVX512F support])
+AVX512_SUPPORT=no
+if grep -q avx512f /proc/cpuinfo 2>/dev/null; then
+    AVX512_SUPPORT=yes
+fi
+AC_MSG_RESULT([$AVX512_SUPPORT])
+
+AC_MSG_CHECKING([for AVX2 support])
+AVX2_SUPPORT=no
+if test "$AVX512_SUPPORT" = "no"; then
+    if grep -q avx2 /proc/cpuinfo 2>/dev/null; then
+        AVX2_SUPPORT=yes
+    fi
+fi
+AC_MSG_RESULT([$AVX2_SUPPORT])
+
+USE_REF=no
+if test "$AVX512_SUPPORT" = "no" && test "$AVX2_SUPPORT" = "no"; then
+    USE_REF=yes
+fi
+
+AM_CONDITIONAL([USE_AVX512], [test "$AVX512_SUPPORT" = "yes"])
+AM_CONDITIONAL([USE_AVX2], [test "$AVX2_SUPPORT" = "yes"])
+AM_CONDITIONAL([USE_REF], [test "$USE_REF" = "yes"])
+
+# Set SIMD CFLAGS globally
+AC_SUBST([CFLAGS], "$CFLAGS -mavx2 -mavx512f -march=skylake-avx512")
+
+# Build files
+AC_CONFIG_FILES([
+  Makefile
+  libslhdsa.pc
+])
+
+# Check for libsodium
+PKG_CHECK_MODULES([LIBSODIUM], [libsodium >= 1.0.18], [], [
+  AC_MSG_ERROR([libsodium >= 1.0.18 is required])
+])
+AC_SUBST([LIBSODIUM_CFLAGS])
+AC_SUBST([LIBSODIUM_LIBS])
+
+AC_OUTPUT
