diff --git a/crypto/slhdsa/libslhdsa/include/slhdsa.h b/crypto/slhdsa/libslhdsa/include/slhdsa.h
new file mode 100644
index 000000000..926deebd8
--- /dev/null
+++ b/crypto/slhdsa/libslhdsa/include/slhdsa.h
@@ -0,0 +1,101 @@
+#ifndef SLHDSA_H
+#define SLHDSA_H
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+
+#include <stddef.h>
+#include <stdint.h>
+#include <string.h>
+#include "../include/shake.h"
+#include "../include/params.h"
+
+
+// Structure to hold the parsed public key in the same format as secp256k1
+typedef struct {       // Length of the public key data
+    unsigned char data[SLH_PK_BYTES]; // Assuming the SLHDSA public key is of length SLH_PK_BYTES
+} slhdsa_pubkey;
+
+/**
+ * Returns an array containing a detached signature.
+ */
+int slhdsa_sign_message(uint8_t* sig, size_t* siglen,
+                        const uint8_t* m, size_t mlen, const uint8_t* sk);
+
+/**
+ * Verifies a detached signature and message under a given public key.
+ */
+int slhdsa_signature_verify(const uint8_t* sig, size_t siglen,
+                            const uint8_t* m, size_t mlen, const uint8_t* pk);
+
+/**
+ * Verifies a given signature-message pair under a given public key.
+ */
+int slhdsa_sign_verify_signature(unsigned char* m, unsigned long long* mlen,
+                                 const unsigned char* sm, unsigned long long smlen,
+                                 const unsigned char* pk);
+
+/**
+ * Derives the secret key from a given seed.
+ * Format sk: [SK_SEED || SK_PRF || PUB_SEED || root]
+ */
+void get_secretkey(unsigned char* sk, const unsigned char* seed);
+
+/**
+ * Derives the public key from a given secret key.
+ * Format pk: [PUB_SEED || root]
+ */
+void get_pubkey(const unsigned char* pk, const unsigned char* sk);
+
+/**
+ * Generates a SLHDSA public key given a secret key.
+ * Format pk: [PUB_SEED || root]
+ */
+int slhdsa_gen_pubkey(const unsigned char* sk, const unsigned char* pk);
+
+/**
+ * Generates a SLHDSA private key.
+ * Format sk: [SK_SEED || SK_PRF || PUB_SEED || root]
+ */
+int slhdsa_gen_privatekey(unsigned char* sk);
+
+/**
+ * Verifies given secret key is a valid slhdsa secret key
+ */
+int slhdsa_seckey_verify(const unsigned char* seckey);
+
+/**
+ * Prints the key in hexadecimal format.
+ */
+void print_key_hex(const char* label, const unsigned char* data, size_t len);
+
+void slhdsa_selftest();
+
+int slhdsa_ec_pubkey_parse(slhdsa_pubkey* pubkey, const unsigned char* input, size_t inputlen);
+
+int slhdsa_pubkey_cmp(const unsigned char* pubkey0, const unsigned char* pubkey1);
+
+/**
+ * Generates a SLHDSA secret key from a provided master seed.
+ * The seed is processed using the shake256 function to create a deterministic secret key.
+ *
+ * @param master_seed Pointer to the input seed data (master seed) to generate the secret key.
+ * @param master_seed_len The length of the master seed in bytes.
+ * @param sk Pointer to the output buffer where the generated secret key will be stored.
+ *
+ * @return 0 on success, -1 if the input pointers are null.
+ *
+ * Note: The output secret key (sk) buffer must be pre-allocated and should be large enough
+ *       to hold the resulting secret key.
+ */
+int generate_seckey_from_seed(const unsigned char* master_seed, size_t master_seed_len, unsigned char* sk);
+
+void shake_256(const uint8_t *M, size_t M_len, uint8_t *buffer, uint32_t out_len);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif // SLHDSA_H
