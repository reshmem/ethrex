new file mode 100644
index 000000000..12d89b4eb
--- /dev/null
+++ b/crypto/slhdsa/slhdsa.go
@@ -0,0 +1,422 @@
+package slhdsa
+
+/*
+#cgo CFLAGS: -I${SRCDIR}/libslhdsa/include
+#cgo LDFLAGS: ${SRCDIR}/libslhdsa/.libs/libslhdsa.a -lgcrypt -lsodium -lssl -lcrypto -lm
+#include <slhdsa.h>
+*/
+import "C"
+import (
+	"bytes"
+	"crypto"
+	"crypto/aes"
+	"crypto/cipher"
+	"crypto/hmac"
+	"crypto/rand"
+	"crypto/sha512"
+	"crypto/subtle"
+	"encoding/binary"
+	"errors"
+	"fmt"
+	"hash"
+	"io"
+	"unsafe"
+)
+
+// Constants for key sizes
+const (
+	SLHPrivateKeySize = int(C.SLH_SK_BYTES) // Example: 128 bytes
+	SLHPublicKeySize  = int(C.SLH_PK_BYTES) // Example: 64 bytes
+	SLHSignatureSize  = int(C.SLH_BYTES + C.SLH_PK_BYTES)          // Example: 49920 bytes
+)
+
+// SLHDSA Private Key
+type PrivateKey struct {
+	SK        []byte // Fixed-size secret key (seed + PRF key)
+	PublicKey        // Embed public key for easy access
+}
+
+// SLHDSA Public Key
+type PublicKey struct {
+	PK     []byte       // Fixed-size public key
+	Params SLHDSAParams // SLHDSA parameters (hash function, etc.)
+}
+
+// SLHDSA Parameters
+type SLHDSAParams struct {
+	Hash      func() hash.Hash                   // Hash function (e.g., SHA-256)
+	hashAlgo  crypto.Hash                        // Hash algorithm type
+	Cipher    func([]byte) (cipher.Block, error) // Symmetric cipher function
+	BlockSize int                                // Cipher block size
+	KeyLen    int                                // Symmetric key length
+}
+
+// Get SLHDSA Private Key Size
+func SLHSKBytes() int {
+	return SLHPrivateKeySize
+}
+
+// Get SLHDSA Public Key Size
+func SLHPKBytes() int {
+	return SLHPublicKeySize
+}
+
+// GenerateKey generates a SLHDSA private and public key pair.
+func GenerateNewKey() (PrivateKey, error) {
+	// Generate random seed
+	seed := make([]byte, C.SLH_BYTES)
+	_, err := rand.Read(seed)
+	if err != nil {
+		return PrivateKey{}, fmt.Errorf("failed to generate seed: %v", err)
+	}
+
+	// Allocate memory for private and public keys
+	SK := make([]byte, C.SLH_SK_BYTES)
+	PK := make([]byte, C.SLH_PK_BYTES)
+
+	// Generate private key
+	C.slhdsa_gen_privatekey((*C.uchar)(unsafe.Pointer(&SK[0])))
+
+	// Generate public key
+	if C.slhdsa_gen_pubkey((*C.uchar)(unsafe.Pointer(&SK[0])), (*C.uchar)(unsafe.Pointer(&PK[0]))) != 0 {
+		return PrivateKey{}, fmt.Errorf("failed to generate public key")
+	}
+
+	privKey := &PrivateKey{
+		SK: SK,
+		PublicKey: PublicKey{
+			PK: PK,
+		},
+	}
+
+	return *privKey, nil
+}
+
+func GenerateKey(rand io.Reader) (*PrivateKey, error) {
+	// Generate random seed from the provided io.Reader
+	seed := make([]byte, C.SLH_BYTES)
+	_, err := rand.Read(seed)
+	if err != nil {
+		return &PrivateKey{}, fmt.Errorf("failed to generate seed: %v", err)
+	}
+
+	// Allocate memory for private and public keys
+	SK := make([]byte, C.SLH_SK_BYTES)
+	PK := make([]byte, C.SLH_PK_BYTES)
+
+	// Generate private key
+	C.slhdsa_gen_privatekey((*C.uchar)(unsafe.Pointer(&SK[0])))
+
+	// Generate public key
+	if C.slhdsa_gen_pubkey((*C.uchar)(unsafe.Pointer(&SK[0])), (*C.uchar)(unsafe.Pointer(&PK[0]))) != 0 {
+		return &PrivateKey{}, fmt.Errorf("failed to generate public key")
+	}
+
+	privKey := &PrivateKey{
+		SK: SK,
+		PublicKey: PublicKey{
+			PK: PK,
+		},
+	}
+
+	return privKey, nil
+}
+
+// Public returns the public key corresponding to the private key.
+func (priv *PrivateKey) Public() *PublicKey {
+	return &PublicKey{PK: priv.PK}
+}
+
+// DerivePublicKey derives a public key from the given private key.
+func DerivePublicKey(SK []byte) ([]byte, error) {
+	PK := make([]byte, C.SLH_PK_BYTES)
+	if C.slhdsa_gen_pubkey((*C.uchar)(unsafe.Pointer(&SK[0])), (*C.uchar)(unsafe.Pointer(&PK[0]))) != 0 {
+		return nil, fmt.Errorf("failed to generate public key")
+	}
+	return PK, nil
+}
+
+// Sign signs the given message using the provided private key.
+func Sign(m []byte, SK []byte) ([]byte, error) {
+	sig := make([]byte, C.SLH_BYTES) // Buffer for the signature
+	var siglen C.size_t              // Length of the signature
+
+	pub, _ := DerivePublicKey(SK)
+
+	err := C.slhdsa_sign_message((*C.uint8_t)(unsafe.Pointer(&sig[0])),
+		(*C.size_t)(unsafe.Pointer(&siglen)),
+		(*C.uint8_t)(unsafe.Pointer(&m[0])),
+		(C.size_t)(len(m)),
+		(*C.uint8_t)(unsafe.Pointer(&SK[0])))
+
+	// Check for errors
+	if err != 1 {
+		return nil, fmt.Errorf("failed to sign the message: error code %d", err)
+	}
+
+	// Append public key to the signature
+	finalSig := append(sig[:siglen], pub...) // Concatenating signature with public key
+	return finalSig, nil                     // Return final signature with pub key included
+}
+
+// VerifySignature verifies the signature of a message using the public key.
+func VerifySignature(publicKey []byte, message []byte, signature []byte) bool {
+	// Ensure signature length is correct (C.SLH_BYTES + C.SLH_PK_BYTES)
+	if len(signature) != C.SLH_BYTES+C.SLH_PK_BYTES {
+		return false
+	}
+
+	// Verify extracted public key matches provided public key
+	if !bytes.Equal(signature[C.SLH_BYTES:], publicKey) {
+		return false
+	}
+
+	// Call the C function slhdsa_signature_verify using only the first C.SLH_BYTES bytes of signature
+	result := C.slhdsa_signature_verify(
+		(*C.uint8_t)(unsafe.Pointer(&signature[0])), C.size_t(C.SLH_BYTES),
+		(*C.uint8_t)(unsafe.Pointer(&message[0])), C.size_t(len(message)),
+		(*C.uint8_t)(unsafe.Pointer(&publicKey[0])),
+	)
+	return result == 1
+}
+
+// Export an slhdsa private key as an SLHDSA private key.
+func (prv *PrivateKey) ExportSLHDSA() *PrivateKey {
+	pub := &prv.PublicKey
+	pubSLHDSA := pub.ExportSLHDSA()
+	return &PrivateKey{SK: prv.SK, PublicKey: *pubSLHDSA}
+}
+
+// Import an SLHDSA private key as an slhdsa private key.
+func ImportSLHDSA(prv *PrivateKey) *PrivateKey {
+	pub := ImportSLHDSAPublic(&prv.PublicKey)
+	return &PrivateKey{PublicKey: *pub, SK: prv.SK}
+}
+
+// Import an SLHDSA public key as an slhdsa public key.
+func ImportSLHDSAPublic(pub *PublicKey) *PublicKey {
+	return &PublicKey{PK: pub.PK}
+}
+func (pub *PublicKey) ExportSLHDSA() *PublicKey {
+	return &PublicKey{PK: pub.PK}
+}
+
+// GenerateShared performs a key agreement operation to establish a shared secret.
+func (prv *PrivateKey) GenerateShared(pub *PublicKey, skLen, macLen int) (sk []byte, err error) {
+	// Ensure that both private and public keys are not nil
+	if len(prv.SK) == 0 || len(pub.PK) == 0 {
+		return nil, fmt.Errorf("invalid keys: private key or public key is empty")
+	}
+
+	// Generate shared secret based on the scheme used for your new structs.
+	// Assuming a simple XOR or HMAC-based scheme (for example purposes)
+	// Replace with the actual key agreement scheme used in your cryptographic design.
+	sharedSecret := make([]byte, skLen+macLen)
+
+	// Assuming we use a simple example where the shared secret is derived from combining SK and PK.
+	for i := 0; i < len(sharedSecret); i++ {
+		if i < len(prv.SK) && i < len(pub.PK) {
+			sharedSecret[i] = prv.SK[i] ^ pub.PK[i] // XOR for demonstration
+		} else if i < len(prv.SK) {
+			sharedSecret[i] = prv.SK[i]
+		} else if i < len(pub.PK) {
+			sharedSecret[i] = pub.PK[i]
+		}
+	}
+
+	return sharedSecret, nil
+}
+func Encrypt(rand io.Reader, pub *PublicKey, m, s1, s2 []byte) (ct []byte, err error) {
+	params, err := pubkeyParams(pub)
+	R, err := GenerateKey(rand)
+	if err != nil {
+		return nil, err
+	}
+
+	z, err := R.GenerateShared(pub, len(R.PK)/2, len(R.PK)/2)
+	if err != nil {
+		return nil, err
+	}
+
+	hash := params.Hash()
+	Ke, Km := deriveKeys(hash, z, s1, len(R.PK)/2)
+
+	em, err := symEncrypt(rand, params, Ke, m)
+	if err != nil || len(em) <= params.BlockSize {
+		return nil, err
+	}
+
+	d := messageTag(params.Hash, Km, em, s2)
+	ct = make([]byte, len(em)+len(d))
+	copy(ct, em)
+	copy(ct[len(em):], d)
+	return ct, nil
+}
+
+var (
+	ErrSharedTooLong       = errors.New("slhdsa: shared secret is too long")
+	ErrInvalidMessage      = errors.New("slhdsa: invalid message")
+	ErrInvalidMessageLen   = errors.New("slhdsa: invalid message length")
+	ErrInvalidSignatureLen = errors.New("slhdsa: invalid signature length")
+)
+var (
+	ErrImport                     = errors.New("slhdsa: failed to import key")
+	ErrInvalidCurve               = errors.New("slhdsa: invalid elliptic curve")
+	ErrInvalidPublicKey           = errors.New("slhdsa: invalid public key")
+	ErrSharedKeyIsPointAtInfinity = errors.New("slhdsa: shared key is point at infinity")
+	ErrSharedKeyTooBig            = errors.New("slhdsa: shared key params are too big")
+)
+
+// Decrypt decrypts an slhdsa ciphertext.
+func (prv *PrivateKey) Decrypt(c, s1, s2 []byte) (m []byte, err error) {
+	if len(c) == 0 {
+		return nil, ErrInvalidMessage
+	}
+	params, err := pubkeyParams(&prv.PublicKey)
+	if err != nil {
+		return nil, err
+	}
+
+	hash := params.Hash()
+
+	var (
+		rLen   int
+		hLen   int = hash.Size()
+		mStart int
+		mEnd   int
+	)
+
+	switch c[0] {
+	case 2, 3, 4:
+		rLen = 64
+		if len(c) < (rLen + hLen + 1) {
+			return nil, ErrInvalidMessage
+		}
+	default:
+		return nil, ErrInvalidPublicKey
+	}
+
+	mStart = rLen
+	mEnd = len(c) - hLen
+
+	R := new(PublicKey)
+	//R.Curve = prv.PublicKey.Curve
+	z, err := prv.GenerateShared(R, params.KeyLen, params.KeyLen)
+	if err != nil {
+		return nil, err
+	}
+	Ke, Km := deriveKeys(hash, z, s1, params.KeyLen)
+
+	d := messageTag(params.Hash, Km, c[mStart:mEnd], s2)
+	if subtle.ConstantTimeCompare(c[mEnd:], d) != 1 {
+		return nil, ErrInvalidMessage
+	}
+	return symDecrypt(params, Ke, c[mStart:mEnd])
+}
+func symDecrypt(params *SLHDSAParams, key, ct []byte) (m []byte, err error) {
+	c, err := params.Cipher(key)
+	if err != nil {
+		return
+	}
+
+	ctr := cipher.NewCTR(c, ct[:params.BlockSize])
+
+	m = make([]byte, len(ct)-params.BlockSize)
+	ctr.XORKeyStream(m, ct[params.BlockSize:])
+	return
+}
+
+// deriveKeys creates the encryption and MAC keys using concatKDF.
+func deriveKeys(hash hash.Hash, z, s1 []byte, keyLen int) (Ke, Km []byte) {
+	K := concatKDF(hash, z, s1, 2*keyLen)
+	Ke = K[:keyLen]
+	Km = K[keyLen:]
+	hash.Reset()
+	hash.Write(Km)
+	Km = hash.Sum(Km[:0])
+	return Ke, Km
+}
+func symEncrypt(rand io.Reader, params *SLHDSAParams, key, m []byte) (ct []byte, err error) {
+	c, err := params.Cipher(key)
+	if err != nil {
+		return
+	}
+
+	iv, err := generateIV(params, rand)
+	if err != nil {
+		return
+	}
+	ctr := cipher.NewCTR(c, iv)
+
+	ct = make([]byte, len(m)+params.BlockSize)
+	copy(ct, iv)
+	ctr.XORKeyStream(ct[params.BlockSize:], m)
+	return
+}
+func generateIV(params *SLHDSAParams, rand io.Reader) (iv []byte, err error) {
+	iv = make([]byte, params.BlockSize)
+	_, err = io.ReadFull(rand, iv)
+	return
+}
+func pubkeyParams(key *PublicKey) (*SLHDSAParams, error) {
+	return &SLHDSAParams{Hash: sha512.New,
+		hashAlgo:  crypto.SHA512,
+		Cipher:    aes.NewCipher,
+		BlockSize: aes.BlockSize,
+		KeyLen:    32}, nil
+}
+
+// messageTag computes the MAC of a message (called the tag) as per
+// SEC 1, 3.5.
+func messageTag(hash func() hash.Hash, km, msg, shared []byte) []byte {
+	mac := hmac.New(hash, km)
+	mac.Write(msg)
+	mac.Write(shared)
+	tag := mac.Sum(nil)
+	return tag
+}
+
+// NIST SP 800-56 Concatenation Key Derivation Function (see section 5.8.1).
+func concatKDF(hash hash.Hash, z, s1 []byte, kdLen int) []byte {
+	counterBytes := make([]byte, 4)
+	k := make([]byte, 0, roundup(kdLen, hash.Size()))
+	for counter := uint32(1); len(k) < kdLen; counter++ {
+		binary.BigEndian.PutUint32(counterBytes, counter)
+		hash.Reset()
+		hash.Write(counterBytes)
+		hash.Write(z)
+		hash.Write(s1)
+		k = hash.Sum(k)
+	}
+	return k[:kdLen]
+}
+
+// roundup rounds size up to the next multiple of blocksize.
+func roundup(size, blocksize int) int {
+	return size + blocksize - (size % blocksize)
+}
+
+func RecoverPubkey(msg []byte, sig []byte) ([]byte, error) {
+	if len(msg) != 32 {
+		return nil, ErrInvalidMessageLen
+	}
+	if len(sig) != SLHSignatureSize {
+		return nil, ErrInvalidSignatureLen
+	}
+
+	var pubkey = make([]byte, 65)
+
+	// Extract the public key (last `PublicKeyLength` bytes of signature)
+	pubkey = sig[49856:]
+
+	// Ensure the public key is valid
+	if len(pubkey) == 0 {
+		return nil, errors.New("invalid public key in signature")
+	}
+
+	// verify the given message with the signature
+	if !VerifySignature(pubkey, msg, sig) {
+		return nil, errors.New("slhdsa: invalid signature for the message")
+	}
+	return pubkey, nil
+}
