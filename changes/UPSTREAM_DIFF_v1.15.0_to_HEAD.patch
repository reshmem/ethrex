+const Apple = artifacts.require("Apple");
+const Banana = artifacts.require("Banana");
+const Cat = artifacts.require("Cat");
+const Dog = artifacts.require("Dog");
+const Egg = artifacts.require("Egg");
+const Frog = artifacts.require("Frog");
+
+contract("Inheritance Contracts", () => {
+  let appleInstance, bananaInstance, catInstance, dogInstance, eggInstance, frogInstance;
+
+  describe("Base Contracts", () => {
+    before(async () => {
+      // Deploy the base contracts directly for testing purposes
+      appleInstance = await Apple.new("Direct Apple Deployment");
+      bananaInstance = await Banana.new("Direct Banana Deployment");
+    });
+
+    it("Should set the correct name in Apple contract", async () => {
+      const name = await appleInstance.name();
+      assert.equal(name, "Direct Apple Deployment", "Name in Apple contract should match constructor input");
+      console.log("Apple contract name:", name);
+    });
+
+    it("Should set the correct text in Banana contract", async () => {
+      const text = await bananaInstance.text();
+      assert.equal(text, "Direct Banana Deployment", "Text in Banana contract should match constructor input");
+      console.log("Banana contract text:", text);
+    });
+  });
+
+  describe("Contract Cat (Fixed Constructor Parameters)", () => {
+    before(async () => {
+      catInstance = await Cat.new();
+    });
+
+    it("Should have the correct name from Apple", async () => {
+      const name = await catInstance.name();
+      assert.equal(name, "Input to Apple", "Name in Cat contract should match the hardcoded value");
+      console.log("Cat contract name:", name);
+    });
+
+    it("Should have the correct text from Banana", async () => {
+      const text = await catInstance.text();
+      assert.equal(text, "Input to Banana", "Text in Cat contract should match the hardcoded value");
+      console.log("Cat contract text:", text);
+    });
+  });
+
+  describe("Contract Dog (Constructor with Parameters)", () => {
+    before(async () => {
+      dogInstance = await Dog.new("Dog's Apple Input", "Dog's Banana Input");
+    });
+
+    it("Should have the correct name from Apple", async () => {
+      const name = await dogInstance.name();
+      assert.equal(name, "Dog's Apple Input", "Name in Dog contract should match the provided value");
+      console.log("Dog contract name:", name);
+    });
+
+    it("Should have the correct text from Banana", async () => {
+      const text = await dogInstance.text();
+      assert.equal(text, "Dog's Banana Input", "Text in Dog contract should match the provided value");
+      console.log("Dog contract text:", text);
+    });
+  });
+
+  describe("Contract Egg (Constructor Order Test 1)", () => {
+    before(async () => {
+      eggInstance = await Egg.new();
+    });
+
+    it("Should have the correct name from Apple despite ordering", async () => {
+      const name = await eggInstance.name();
+      assert.equal(name, "Apple was called", "Name in Egg contract should match the constructor value");
+      console.log("Egg contract name:", name);
+    });
+
+    it("Should have the correct text from Banana despite ordering", async () => {
+      const text = await eggInstance.text();
+      assert.equal(text, "Banana was called", "Text in Egg contract should match the constructor value");
+      console.log("Egg contract text:", text);
+    });
+  });
+
+  describe("Contract Frog (Constructor Order Test 2)", () => {
+    before(async () => {
+      frogInstance = await Frog.new();
+    });
+
+    it("Should have the correct name from Apple despite reversed constructor order", async () => {
+      const name = await frogInstance.name();
+      assert.equal(name, "Apple was called", "Name in Frog contract should match the constructor value");
+      console.log("Frog contract name:", name);
+    });
+
+    it("Should have the correct text from Banana despite reversed constructor order", async () => {
+      const text = await frogInstance.text();
+      assert.equal(text, "Banana was called", "Text in Frog contract should match the constructor value");
+      console.log("Frog contract text:", text);
+    });
+
+    it("Should demonstrate that parent constructors are always called in inheritance order", async () => {
+      // This test validates that even though Frog's constructor calls Banana before Apple
+      // The actual instantiation still calls Apple's constructor first (due to inheritance order)
+      const nameE = await frogInstance.name();
+      const textE = await frogInstance.text();
+      console.log("Frog inheritance order test - Apple.name:", nameE, "Banana.text:", textE);
+      
+      // No actual assertion needed - we're just demonstrating the behavior
+      // The actual validation is in the logs comparison
+    });
+  });
+});
