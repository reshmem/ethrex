+const IfElse = artifacts.require("IfElse");
+
+contract("IfElse", () => {
+  let ifElse;
+
+  beforeEach(async () => {
+    ifElse = await IfElse.new();
+  });
+
+  describe("foo()", () => {
+    it("should return 0 when input is less than 10", async () => {
