index 000000000..290857516
--- /dev/null
+++ b/tests/solidity/test/Hacks/63_gas_rule.js
@@ -0,0 +1,45 @@
+const A = artifacts.require("A");
+const B = artifacts.require("B");
+
+contract("Gas Refund Exploit Test (Single Account)", async (accounts) => {
+  const user = accounts[0]; // Only use the first account
+
+  let a, b;
+
+  beforeEach(async () => {
+    // Deploy both contracts from the same account
+    b = await B.new({ from: user });
+    a = await A.new({ from: user });
+
+    // Fund B contract
+    await web3.eth.sendTransaction({
+      from: user,
+      to: b.address,
+      value: web3.utils.toWei("10", "ether"),
+    });
+
+    // Authorize contract A in contract B
+    await b.setAuth(a.address, true, { from: user });
+  });
+
+  it("should attempt to drain Ether using gas refund logic", async () => {
+    const initialBalance = web3.utils.toBN(await web3.eth.getBalance(user));
+
+    // Call A.f(), which triggers B.g() to send gas value as ETH
+    const tx = await a.f(b.address, {
+      from: user,
+      gas: 9_000_000, // High gas limit to simulate the gas refund attack
+    });
+
+    const finalBalance = web3.utils.toBN(await web3.eth.getBalance(user));
+    const bBalance = web3.utils.toBN(await web3.eth.getBalance(b.address));
+
+    console.log("B contract balance after:", web3.utils.fromWei(bBalance, "ether"));
+    console.log("User ETH change:", finalBalance.sub(initialBalance).toString());
+
+    assert(
+      bBalance.lt(web3.utils.toBN(web3.utils.toWei("10", "ether"))),
+      "Ether should have been drained from contract B"
+    );
+  });
+});
