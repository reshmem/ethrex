diff --git a/tests/solidity/test/Basic/abi_decode.js b/tests/solidity/test/Basic/abi_decode.js
new file mode 100644
index 000000000..798efab96
--- /dev/null
+++ b/tests/solidity/test/Basic/abi_decode.js
@@ -0,0 +1,41 @@
+const AbiDecode = artifacts.require("AbiDecode");
+
+contract("AbiDecode", accounts => {
+  const user = accounts[0];
+
+  it("should encode and decode complex data correctly", async () => {
+    const instance = await AbiDecode.deployed();
+
+    const x = 123;
+    const addr = user;
+    const arr = [1, 2, 3];
+    const myStruct = {
+      name: "test",
+      nums: [4, 5],
+    };
+
+    // Web3 ABI encode
+    const abi = web3.eth.abi;
+    const encoded = abi.encodeParameters(
+      [
+        "uint256",
+        "address",
+        "uint256[]",
+        "tuple(string name, uint256[2] nums)",
+      ],
+      [x, addr, arr, [myStruct.name, myStruct.nums]]
+    );
+
+    const decoded = await instance.decode(encoded);
+
+    assert.equal(decoded.x.toString(), x.toString(), "Incorrect x");
+    assert.equal(decoded.addr.toLowerCase(), addr.toLowerCase(), "Incorrect address");
+    assert.deepEqual(decoded.arr.map(n => Number(n)), arr, "Incorrect array");
+    assert.equal(decoded.myStruct.name, myStruct.name, "Incorrect struct name");
+    assert.deepEqual(
+      decoded.myStruct.nums.map(n => Number(n)),
+      myStruct.nums,
+      "Incorrect struct nums"
+    );
+  });
+});
diff --git a/tests/solidity/test/Basic/abi_encode.js b/tests/solidity/test/Basic/abi_encode.js
