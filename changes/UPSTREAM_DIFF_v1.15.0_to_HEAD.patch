@@ -0,0 +1,108 @@
+name: Unit test
+
+on:
+  workflow_dispatch:
+    inputs:
+      branch:
+        description: 'Branch to run the workflow on'
+        required: false
+        default: 'develop'
+
+concurrency:
+  group: ${{ github.event_name != 'pull_request' && github.run_id || github.ref }}
+  cancel-in-progress: true
+
+env:
+  CI_FAILFAST_TEST_LEAVE_DANGLING: 1
+  MAKEJOBS: '7'
+
+jobs:
+  check-new-commits:
+    name: 'Fetch New Commits and Check for Changes'
+    runs-on: self-hosted
+    outputs:
+      has_new_commits: ${{ steps.check_commits.outputs.has_new_commits }}
+    steps:
+      - name: Print Event Info
+        run: |
+          echo "Triggered by: ${{ github.event_name }}"
+          echo "Branch Ref: ${{ github.ref }}"
+          echo "Inputs.branch: ${{ github.event.inputs.branch }}"
+
+      - name: Checkout code
+        uses: actions/checkout@v4
+        with:
+          ref: ${{ github.ref_name }}
+          fetch-depth: 0
+
+      - name: Fetch new commits and check for changes
+        id: check_commits
+        run: |
+          git fetch origin ${{ github.ref_name }}
+          NEW_COMMITS=$(git log origin/${{ github.ref_name }} --since="24 hours ago" --oneline)
+          if [ -z "$NEW_COMMITS" ]; then
+            echo "No new commits in the last 24 hours. Skipping CI job."
+            echo "::set-output name=has_new_commits::false"
+          else
+            echo "New commits found:"
+            echo "$NEW_COMMITS"
+            echo "Triggering CI job."
+            echo "::set-output name=has_new_commits::true"
+          fi
+        shell: bash
+
+  ci-job:
+    name: 'Compile and Run Unit Tests'
+    runs-on: self-hosted
+    needs: check-new-commits
+    if: ${{ needs.check-new-commits.outputs.has_new_commits == 'true' && github.ref_name != 'main' }}
+    timeout-minutes: 360
+    steps:
+      - name: Validate Dependencies
+        run: |
+          python3 --version || exit 1
+          which make || exit 1
+        shell: bash
+
+      - name: Determine fetch depth
+        run: |
+          FETCH_DEPTH=0
+          if [[ "${{ github.event_name }}" == "pull_request" ]]; then
+            FETCH_DEPTH=$(( github.event.pull_request.commits + 2 ))
+          fi
+          echo "FETCH_DEPTH=$FETCH_DEPTH" >> "$GITHUB_ENV"
+        shell: bash
+
+      - name: Checkout code
+        uses: actions/checkout@v4
+        with:
+          ref: ${{ github.event.inputs.branch || github.ref_name }}
+          fetch-depth: ${{ env.FETCH_DEPTH }}
+
+      - name: Compile Code
+        run: |
+          git submodule update --init --recursive
+        shell: bash
+
+      - name: Run Unit Tests
+        run: |
+          python3 go_test_runner.py || exit 1
+        shell: bash
+
+  upload-log:
+    name: 'Upload Logs'
+    runs-on: self-hosted
+    needs: ci-job
+    if: ${{ needs.ci-job.result == 'success' && github.ref_name != 'main' }}
+    steps:
+      - name: Execute Upload Script
+        run: |
+          if [ -d /home/developer/azure_upload_l2 ]; then
+            cd /home/developer/azure_upload_l2
+            chmod +x upload.sh
+            bash ./upload.sh || exit 1
+          else
+            echo "Upload directory not found!"
+            exit 1
+          fi
+        shell: /usr/bin/bash --noprofile --norc -e -o pipefail {0}
