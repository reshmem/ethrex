@@ -0,0 +1,46 @@
+const Token = artifacts.require("Token");
+const AbiEncode = artifacts.require("AbiEncode");
+
+contract("AbiEncode", (accounts) => {
+  let token, encoder;
+  const user = accounts[0];
+
+  beforeEach(async () => {
+    token = await Token.new({ from: user });
+    encoder = await AbiEncode.new({ from: user });
+  });
+
+  it("calls transfer using abi.encodeWithSignature", async () => {
+    const data = await encoder.encodeWithSignature(user, 100, { from: user });
+    const tx = await encoder.test(token.address, data, { from: user });
+    assert(tx.receipt.status, "Transaction should succeed");
+  });
+
+  it("calls transfer using abi.encodeWithSelector", async () => {
+    const data = await encoder.encodeWithSelector(user, 200, { from: user });
+    const tx = await encoder.test(token.address, data, { from: user });
+    assert(tx.receipt.status, "Transaction should succeed");
+  });
+
+  it("calls transfer using abi.encodeCall", async () => {
+    const data = await encoder.encodeCall(user, 300, { from: user });
+    const tx = await encoder.test(token.address, data, { from: user });
+    assert(tx.receipt.status, "Transaction should succeed");
+  });
+
+  it("reverts if called on non-contract address", async () => {
+    const data = await encoder.encodeWithSignature(user, 123, { from: user });
+  
+    // call returns false but may not revert with reason
+    try {
+      await encoder.test(user, data, { from: user });
+      assert.fail("Expected transaction to revert");
+    } catch (err) {
+      assert(
+        err.message.includes("call failed") || err.message.includes("revert"),
+        "Expected revert due to call to non-contract address"
+      );
+    }
+  });
+  
+});
