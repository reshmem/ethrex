+// GNU Lesser General Public License for more details.
+//
+// You should have received a copy of the GNU Lesser General Public License
+// along with the go-ethereum library. If not, see <http://www.gnu.org/licenses/>.
+
+const EventDrivenArchitecture = artifacts.require("EventDrivenArchitecture");
+const EventSubscription = artifacts.require("EventSubscription");
+
+contract("Event System (Single Account)", (accounts) => {
+  let eda, es;
+  const user = accounts[0];
+  let transferId;
+
+  before(async () => {
+    eda = await EventDrivenArchitecture.deployed();
+    es = await EventSubscription.deployed();
+  });
+
+  it("should emit TransferInitiated event", async () => {
+    const tx = await eda.initiateTransfer(user, 123, { from: user });
+
+    assert.equal(tx.logs[0].event, "TransferInitiated");
+    assert.equal(tx.logs[0].args.from, user);
+    assert.equal(tx.logs[0].args.to, user);
+    assert.equal(tx.logs[0].args.value.toString(), "123");
+  });
+
+  it("should confirm transfer and emit event", async () => {
+    transferId = web3.utils.soliditySha3("dummy123");
+    const tx = await eda.confirmTransfer(transferId, { from: user });
+
+    assert.equal(tx.logs[0].event, "TransferConfirmed");
+    const confirmed = await eda.transferConfirmations(transferId);
+    assert.isTrue(confirmed, "Transfer should be marked as confirmed");
+  });
+
+  it("should allow user to subscribe and unsubscribe", async () => {
+    let subscribed = await es.subscribers(user);
+    assert.isFalse(subscribed, "User should not be subscribed yet");
+
+    await es.subscribe({ from: user });
+
+    subscribed = await es.subscribers(user);
+    assert.isTrue(subscribed, "User should be subscribed");
+
+    await es.unsubscribe({ from: user });
+
+    subscribed = await es.subscribers(user);
+    assert.isFalse(subscribed, "User should be unsubscribed");
+  });
+
+  it("should emit LogTransfer event on transfer", async () => {
+    await es.subscribe({ from: user });
+
+    const tx = await es.transfer(user, 999, { from: user });
+
+    assert.equal(tx.logs[0].event, "LogTransfer");
+    assert.equal(tx.logs[0].args.from, user);
+    assert.equal(tx.logs[0].args.to, user);
+    assert.equal(tx.logs[0].args.value.toString(), "999");
+  });
+});
+
diff --git a/tests/solidity/test/Basic/fallback.js b/tests/solidity/test/Basic/fallback.js
new file mode 100644
index 000000000..9606b29d7
--- /dev/null
+++ b/tests/solidity/test/Basic/fallback.js
@@ -0,0 +1,28 @@
+const Counter = artifacts.require("Counter");
+const FallbackInputOutput = artifacts.require("FallbackInputOutput");
+const TestFallbackInputOutput = artifacts.require("TestFallbackInputOutput");
+
+contract("TestFallbackInputOutput", (accounts) => {
+  it("should forward call via fallback and log response", async () => {
+    const counter = await Counter.new();
+    const fallbackProxy = await FallbackInputOutput.new(counter.address);
+    const tester = await TestFallbackInputOutput.new();
+
+    // Fix: Access return values as object properties
+    const result = await tester.getTestData();
+    const getData = result[0];
+    const incData = result[1];
+
+    // Initial count via fallback call
+    const getTx = await tester.test(fallbackProxy.address, getData);
+    const getLog = getTx.logs.find((log) => log.event === "Log");
+    const countBefore = web3.eth.abi.decodeParameter("uint256", getLog.args.res);
+    assert.equal(countBefore, "0", "Initial count should be 0");
+
+    // Increment via fallback call
+    const incTx = await tester.test(fallbackProxy.address, incData);
+    const incLog = incTx.logs.find((log) => log.event === "Log");
+    const countAfter = web3.eth.abi.decodeParameter("uint256", incLog.args.res);
+    assert.equal(countAfter, "1", "Count should be incremented to 1");
+  });
+});
