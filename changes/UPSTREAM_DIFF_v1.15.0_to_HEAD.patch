diff --git a/go_test_runner.py b/go_test_runner.py
new file mode 100644
index 000000000..678a3c4a2
--- /dev/null
+++ b/go_test_runner.py
@@ -0,0 +1,114 @@
+import os
+import subprocess
+import time
+from datetime import datetime
+from typing import Dict
+
+# Retry settings
+MAX_RETRIES = 3
+RETRY_DELAY = 30  # seconds
+
+# Test timeout in seconds
+TIMEOUT = 1800  # 30 minutes
+
+# Directory to save logs
+LOG_DIR = os.path.expanduser("~/azure_upload_l2/logs")
+
+
+def ensure_log_dir():
+    if not os.path.exists(LOG_DIR):
+        os.makedirs(LOG_DIR)
+
+
+def run_go_tests() -> str:
+    """Run Go tests and save output to a log file."""
+    timestamp = datetime.now().strftime("%Y%m%d_%H%M%S")
+    log_file = os.path.join(LOG_DIR, f"all_test_case_outputs_{timestamp}.log")
+
+    print(f"🧪 Running Go tests. Output will be saved to {log_file}...")
+
+    try:
+        with open(log_file, 'w') as f:
+            subprocess.run(
+                ["go", "test", "./...", "-v"],
+                stdout=f,
+                stderr=subprocess.STDOUT,
+                check=True,
+                timeout=TIMEOUT
+            )
+        print("✅ Go tests completed successfully.")
+    except subprocess.CalledProcessError:
+        print("❌ Go tests failed. Output captured.")
+    except subprocess.TimeoutExpired:
+        print(f"⚠️ Test run exceeded timeout of {TIMEOUT} seconds.")
+
+    return log_file
+
+
+def parse_test_log(log_path: str) -> Dict[str, int]:
+    """Parse Go test output log and count results."""
+    counters = {
+        'passed': 0,
+        'failed': 0,
+        'skipped': 0
+    }
+
+    if not os.path.exists(log_path):
+        print(f"Log file '{log_path}' not found.")
+        return counters
+
+    with open(log_path, 'r') as f:
+        for line in f:
+            line = line.strip()
+            if line.startswith('--- PASS:'):
+                counters['passed'] += 1
+            elif line.startswith('--- FAIL:'):
+                counters['failed'] += 1
+            elif line.startswith('--- SKIP:'):
+                counters['skipped'] += 1
+
+    return counters
+
+
+def save_summary(counters: Dict[str, int], original_log: str):
+    """Save summary file alongside full test output."""
+    timestamp = datetime.now().strftime("%Y%m%d_%H%M%S")
+    summary_file = os.path.join(LOG_DIR, f"test_summary_{timestamp}.log")
+
+    total = counters['passed'] + counters['failed'] + counters['skipped']
+    pass_rate = (counters['passed'] / total * 100) if total else 0.0
+
+    with open(summary_file, 'w') as f:
+        f.write(f"Go Test Summary ({datetime.now()})\n")
+        f.write(f"---------------------------------\n")
+        f.write(f"Passed : {counters['passed']}\n")
+        f.write(f"Failed : {counters['failed']}\n")
+        f.write(f"Skipped: {counters['skipped']}\n")
+        f.write(f"Total  : {total}\n")
+        f.write(f"Pass % : {pass_rate:.2f}%\n")
+        f.write(f"Full log: {original_log}\n")
+
+    print(f"📄 Summary saved to {summary_file}")
+
+
+def main():
+    ensure_log_dir()
+
+    retries = 0
+    while retries < MAX_RETRIES:
+        log_path = run_go_tests()
+        counters = parse_test_log(log_path)
+
+        if counters['failed'] == 0:
+            break
+        else:
+            print(f"🔁 Retry attempt {retries + 1}/{MAX_RETRIES} after failure...")
+            time.sleep(RETRY_DELAY)
+            retries += 1
+
+    save_summary(counters, log_path)
+    print("🏁 Test run completed.")
+
+
+if __name__ == "__main__":
+    main()
