+const assert = require('chai').assert;
+const Helpers = require('../lib/helpers');
+var config = require('../lib/config');
+const fs = require('fs');
+
+const beaconHeadPath = 'eth/v1/beacon/headers/head';
+const postPath = 'eth/v1/validator/aggregate_and_proofs';
+const host = config.hosts.validator || 'http://localhost:3500'; // Default to localhost if not set
+const logFile = './validator_test_results.log';
+
+// Helper to format timestamp
+function timestamp() {
+    return new Date().toISOString();
+}
+
+// Clear log file before test run
+before(function(done) {
+    fs.writeFile(logFile, '', (err) => {
+        if (err) return done(err);
+        done();
+    });
+});
+
+// Generate a dummy aggregate_and_proofs body from beacon head
+function buildAggregateAndProofsBody(slot, root) {
+    const baseHex = "0xcf8e0d4e9587369b2301d0790347320302cc0943d5a1884560367e8208d920f2";
+    const signature = "0x1b66ac1fb663c9bc59509846d6ec05345bd908eda73e670af888da41af171505cc411d61252fb6cb3fa0017b679f8bb2305b26a285fa2737f175668d0dff91cc1b66ac1fb663c9bc59509846d6ec05345bd908eda73e670af888da41af171505";
+
+    const aggregateData = {
+        slot: slot.toString(),
+        index: "1",
+        beacon_block_root: root || baseHex,
+        source: {
+            epoch: "1",
+            root: baseHex
+        },
+        target: {
+            epoch: "1",
+            root: baseHex
+        }
+    };
+
+    const proofObject = {
+        message: {
+            aggregate: {
+                aggregation_bits: "0x01",
+                signature: signature,
+                data: aggregateData
+            },
+            aggregator_index: "1",
+            selection_proof: signature
+        },
+        signature: signature
+    };
+
+    return [proofObject, proofObject]; // Array of 2 identical objects
+}
+
+// Main test logic
+const asyncPostTest = function(host, done) {
+    const beaconEndpoint = `${host}/${beaconHeadPath}`;
+    let testResult = 'FAIL';
+
+    // Step 1: Get latest slot from beacon
+    Helpers.httpGet(beaconEndpoint, function(beaconRes, beaconStatus) {
+        if (beaconStatus !== 200 || !beaconRes?.data?.header?.message?.slot) {
+            const logLine = `[${timestamp()}] Host: ${host}\nMethod: ${beaconHeadPath}\nResponse: ${JSON.stringify(beaconRes, null, 2)}\nTest_Result: FAIL (failed to get beacon head)\n\n`;
+            fs.appendFile(logFile, logLine, () => done(new Error('Failed to fetch beacon head')));
+            return;
+        }
+
+        const slot = parseInt(beaconRes.data.header.message.slot);
+        const blockRoot = beaconRes.data.header.message.body_root || null;
+        const postBody = buildAggregateAndProofsBody(slot, blockRoot);
+        const endpoint = `${host}/${postPath}`;
+
+        // Step 2: POST to validator endpoint
+        Helpers.httpPost(endpoint, postBody, function(result, status) {
+            try {
+                if (status === 200 || status === 202) {
+                    testResult = 'PASS';
+                } else {
+                    const errMsg = result.message || 'Unknown error';
+                    console.error(`[${timestamp()}] Error: ${errMsg}`);
+                    assert.fail(`HTTP ${status}: ${errMsg}`);
+                }
+
+                const logLine = `[${timestamp()}] Host: ${host}\nMethod: ${postPath}\nRequest Body: ${JSON.stringify(postBody, null, 2)}\nResponse: ${JSON.stringify(result, null, 2)}\nTest_Result: ${testResult}\n\n`;
+                fs.appendFile(logFile, logLine, (err) => {
+                    if (err) console.error(`[${timestamp()}] Log write failed:`, err);
+                });
+
+                done();
+            } catch (err) {
+                done(err);
+            }
+        });
+    });
+};
