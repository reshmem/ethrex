@@ -0,0 +1,71 @@
+var config = require('../lib/config'),
+    Helpers = require('../lib/helpers'),
+    assert = require('chai').assert;
+const fs = require('fs');  // Import fs for file writing
+
+// METHOD
+var method = 'eth_accounts';
+
+// NEW LOG FILE PATH
+const logFilePath = './logs/eth_test_results.log';  // Path to your log file
+
+// Clear the log file before writing new results
+fs.writeFileSync(logFilePath, '', 'utf8');  // Clear or create the file
+
+// TEST FUNCTION
+var asyncTest = function(host, done) {
+    const params = [];  // No parameters for this method
+
+    Helpers.send(host, {
+        id: config.rpcMessageId++,
+        jsonrpc: "2.0",
+        method: method,
+        params: params
+    }, function(result, status) {
+        let testResult = 'FAIL'; // Default to FAIL
+        try {
+            assert.equal(status, 200, 'has status code');
+            assert.property(result, 'result', (result.error) ? result.error.message : 'error');
+            assert.isArray(result.result, 'is array');
+
+            // Only check address format if there is at least one account
+            if (result.result.length > 0) {
+                assert.isTrue(Helpers.isAddress(result.result[0]), 'first item is a valid address');
+            }
+
+            // If all assertions pass, update testResult to PASS
+            testResult = 'PASS';
+
+            // Prepare the log line with test result and output
+            const logLine = `Host: ${host}\nMethod: ${method}\nParams: ${JSON.stringify(params)}\nResult: ${JSON.stringify(result)}\nTest_Result: ${testResult}\n\n`;
+
+            // Write the result to the log file
+            fs.appendFile(logFilePath, logLine, (err) => {
+                if (err) {
+                    console.error('Error writing to log file:', err);
+                }
+            });
+        } catch (error) {
+            // Log the error to the log file
+            const errorLogLine = `Host: ${host}\nMethod: ${method}\nParams: ${JSON.stringify(params)}\nResponse: ${JSON.stringify(result)}\nTest_Result: ${testResult}\n\n`;
+            fs.appendFile(logFilePath, errorLogLine, (err) => {
+                if (err) {
+                    console.error('Error writing to log file:', err);
+                }
+            });
+            return done(error);
+        }
+        done();
+    });
+};
+
+// DESCRIBE BLOCK
+describe(method, function(){
+    Helpers.eachHost(function(key, host){
+        describe(key, function(){
+            it('should return an array with accounts (can be empty)', function(done){
+                asyncTest(host, done);
+            });
+        });
+    });
+});
