+const { Web3 } = require("web3");
+const web3 = new Web3("http://localhost:8545");
+const Mapping = artifacts.require('Mapping');
+const NestedMapping = artifacts.require('NestedMapping');
+
+contract('Mapping and NestedMapping - Optimized', accounts => {
+  let mapping, nestedMapping;
+
+  before(async () => {
+    mapping = await Mapping.new();
+    nestedMapping = await NestedMapping.new();
+  });
+  describe('Mapping', () => {
+    it('should return 0 for unset address', async () => {
+      const value = await mapping.get(accounts[0]);
+      assert.equal(value.toString(), '0');
+    });
+
+    it('should set and get value correctly', async () => {
+      await mapping.set(accounts[0], 42);
+      const value = await mapping.get(accounts[0]);
+      assert.equal(value.toString(), '42');
+    });
+
+    it('should remove value and return 0', async () => {
+      await mapping.set(accounts[0], 100);
+      await mapping.remove(accounts[0]);
+      const value = await mapping.get(accounts[0]);
+      assert.equal(value.toString(), '0');
+    });
+  });
+  describe('NestedMapping', () => {
+    it('should return false for unset nested mapping', async () => {
+      const value = await nestedMapping.get(accounts[0], 0);
+      assert.isFalse(value);
+    });
+
+    it('should set and get nested value correctly', async () => {
+      await nestedMapping.set(accounts[0], 0, true);
+      const value = await nestedMapping.get(accounts[0], 0);
+      assert.isTrue(value);
+    });
+
+    it('should remove nested value and return false', async () => {
+      await nestedMapping.set(accounts[0], 0, true);
+      await nestedMapping.remove(accounts[0], 0);
+      const value = await nestedMapping.get(accounts[0], 0);
+      assert.isFalse(value);
+    });
+  });
+});
diff --git a/tests/solidity/test/Basic/payable.js b/tests/solidity/test/Basic/payable.js
new file mode 100644
index 000000000..dcfb0a1cd
--- /dev/null
+++ b/tests/solidity/test/Basic/payable.js
@@ -0,0 +1,74 @@
+const Payable = artifacts.require("Payable");
+
+contract("Payable", accounts => {
+  const deployer = accounts[0];
+  let payableInstance;
+
+  beforeEach(async () => {
+    // Deploy with 1 ether
+    payableInstance = await Payable.new({ from: deployer, value: web3.utils.toWei("1", "ether") });
+  });
+
+  it("should accept Ether in constructor", async () => {
+    const balance = await web3.eth.getBalance(payableInstance.address);
+    assert.strictEqual(balance, web3.utils.toWei("1", "ether"));
+  });
+
+  it("should accept Ether via deposit()", async () => {
+    await payableInstance.deposit({ from: deployer, value: web3.utils.toWei("0.5", "ether") });
+
+    const balance = await web3.eth.getBalance(payableInstance.address);
+    assert.strictEqual(balance, web3.utils.toWei("1.5", "ether"));
+  });
+
+  it("should fail if Ether sent to notPayable()", async () => {
+    try {
+      await payableInstance.notPayable({ from: deployer, value: web3.utils.toWei("0.1", "ether") });
+      assert.fail("Expected revert not received");
+    } catch (err) {
+      assert.include(err.message, "revert", "Expected revert error");
+    }
+  });
+
+  it("should allow owner to withdraw all Ether", async () => {
+    const before = BigInt(await web3.eth.getBalance(deployer));
+    const tx = await payableInstance.withdraw({ from: deployer });
+    const after = BigInt(await web3.eth.getBalance(deployer));
+
+    const gasUsed = BigInt(tx.receipt.gasUsed);
+    const txDetails = await web3.eth.getTransaction(tx.tx);
+    const gasPrice = BigInt(txDetails.gasPrice);
+    const gasCost = gasUsed * gasPrice;
+
+    const contractBalance = await web3.eth.getBalance(payableInstance.address);
+    assert.strictEqual(contractBalance, "0", "Contract balance should be zero");
+
+    const expectedMin = BigInt(web3.utils.toWei("1", "ether")) - gasCost;
+    assert(after >= before + expectedMin);
+  });
+
+  it("should transfer ether to recipient", async () => {
+    const to = deployer;
+    const amount = web3.utils.toWei("0.3", "ether");
+
+    const before = BigInt(await web3.eth.getBalance(to));
+    const tx = await payableInstance.transfer(to, amount, { from: deployer });
+    const after = BigInt(await web3.eth.getBalance(to));
+
+    const gasUsed = BigInt(tx.receipt.gasUsed);
+    const txDetails = await web3.eth.getTransaction(tx.tx);
+    const gasPrice = BigInt(txDetails.gasPrice);
+    const gasCost = gasUsed * gasPrice;
+
+    assert(after >= before + BigInt(amount) - gasCost);
+  });
+
+  it("should fail if trying to transfer more than balance", async () => {
+    try {
+      await payableInstance.transfer(deployer, web3.utils.toWei("2", "ether"), { from: deployer });
+      assert.fail("Expected revert not received");
+    } catch (err) {
+      assert.include(err.message, "revert", "Expected revert error");
+    }
+  });
+});
